# /etc/fstab: static file system information.
#
# Use 'blkid' to print the universally unique identifier for a
# device; this may be used with UUID= as a more robust way to name devices
# that works even if disks are added and removed. See fstab(5).
#
# <file system> <mount point>   <type>  <options>       <dump>  <pass>
/dev/disk/by-uuid/9876a1a8-e60b-433e-a319-2ec16ee84ef0 none swap sw 0 0
# / was on /dev/nvme1n1p4 during curtin installation
/dev/disk/by-uuid/6961a116-7df0-4282-9220-a46dbf555ea0 / ext4 defaults 0 1
# /boot/efi was on /dev/nvme1n1p2 during curtin installation
/dev/disk/by-uuid/A331-1F83 /boot/efi vfat defaults 0 1
