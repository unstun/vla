+# ---------------------------------------------------------------
+# [local addition] Remote-run evidence dump.
+# Upstream only renders a figure and prints two numbers; neither can be checked
+# numerically, and this task must also record the GPU memory the run actually
+# used. This writes already-computed values to JSON: it computes no model
+# quantity and is a no-op unless OMNIVLA_RUN_DIR is set.
+# ---------------------------------------------------------------
+MODALITY_NAMES = [
+    "satellite only", "pose and satellite", "satellite and image", "all",
+    "pose only", "pose and image", "image only", "language only",
+    "language and pose",
+]
+
+def dump_run_artifacts(run_dir, waypoints, goal_pose, metric_waypoint_spacing,
+                       waypoint_select, chosen_waypoint, linear_vel, angular_vel,
+                       linear_vel_limit, angular_vel_limit, modality_id, lan_inst,
+                       actions_dtype, forward_seconds):
+    if not run_dir:
+        return
+    os.makedirs(run_dir, exist_ok=True)
+    wp = np.asarray(waypoints, dtype=np.float64)
+    metric = wp.copy()
+    metric[:, :2] *= metric_waypoint_spacing
+    cuda = torch.cuda.is_available()
+    try:
+        attn = getattr(vla.config, "_attn_implementation", None)
+    except Exception:
+        attn = None
+    payload = {
+        "script": "inference/run_omnivla.py",
+        "modality_id": int(modality_id),
+        "modality_name": MODALITY_NAMES[int(modality_id)] if int(modality_id) < len(MODALITY_NAMES) else "unknown",
+        "language_instruction": lan_inst,
+        "metric_waypoint_spacing": float(metric_waypoint_spacing),
+        "waypoints_raw_shape": list(wp.shape),
+        "waypoints_raw": wp.tolist(),
+        "waypoints_metric": metric.tolist(),
+        "waypoint_select_index": int(waypoint_select),
+        "chosen_waypoint_metric": np.asarray(chosen_waypoint, dtype=np.float64).tolist(),
+        "goal_pose_normalized": np.asarray(goal_pose, dtype=np.float64).tolist(),
+        "linear_vel_pd_clipped": float(linear_vel),
+        "angular_vel_pd_clipped": float(angular_vel),
+        "linear_vel_limited": float(linear_vel_limit),
+        "angular_vel_limited": float(angular_vel_limit),
+        "all_finite": bool(np.isfinite(wp).all() and
+                           np.isfinite([linear_vel_limit, angular_vel_limit]).all()),
+        "actions_torch_dtype": str(actions_dtype),
+        "device": str(device_id),
+        "model_dtype": "torch.bfloat16",
+        "attn_implementation": attn,
+        "flash_attn_imported": "flash_attn" in sys.modules,
+        "peak_vram_allocated_bytes": int(torch.cuda.max_memory_allocated()) if cuda else None,
+        "peak_vram_reserved_bytes": int(torch.cuda.max_memory_reserved()) if cuda else None,
+        "cuda_memory_fraction_env": os.environ.get("OMNIVLA_CUDA_MEM_FRACTION"),
+        "vla_path": os.environ.get("OMNIVLA_ORIGINAL_PATH", "./omnivla-original"),
+        "forward_seconds": float(forward_seconds),
+    }
+    out = os.path.join(run_dir, "outputs.json")
+    with open(out, "w") as f:
+        json.dump(payload, f, indent=2)
+    print(f"[local] wrote {out}")
+
