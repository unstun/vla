+def envflag(name, default):
+    """[local addition] Read a boolean modality switch from the environment.
+
+    Upstream expects the user to hand-edit the flags below (README step 3:
+    "modify the settings around line 560"). The sweep needs the same switches
+    without editing the file between runs. Every default is the upstream
+    value, so an unset environment reproduces upstream behaviour exactly.
+    """
+    v = os.environ.get(name)
+    return default if v is None else v.strip().lower() in ("1", "true", "yes", "on")
+
