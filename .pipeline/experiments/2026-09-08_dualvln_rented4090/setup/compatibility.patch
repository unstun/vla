+"""Load optional encoder implementations only when requested.
+
+Upstream imports every encoder eagerly, which pulls
+``internnav.model.basemodel.LongCLIP`` -- a git submodule that is not part of
+the pinned source snapshot. The InternVLA-N1 DualVLN inference path only needs
+DepthAnythingV2, so defer each import to first attribute access, mirroring the
+patch already applied to ``internnav/agent/__init__.py``.
+"""
+from importlib import import_module
+
+_ENCODERS = {
+    'PositionalEncoding': ('bert_backbone', 'PositionalEncoding'),
+    'DistanceNetwork': ('distance_encoder', 'DistanceNetwork'),
+    'ImageEncoder': ('image_clip_encoder', 'ImageEncoder'),
+    'InstructionEncoder': ('instruction_encoder', 'InstructionEncoder'),
+    'InstructionLongCLIPEncoder': ('instruction_longCLIP_encoder', 'InstructionLongCLIPEncoder'),
+    'LanguageEncoder': ('instruction_roberta_encoder', 'LanguageEncoder'),
+    'VisionLanguageEncoder': ('vision_language_encoder', 'VisionLanguageEncoder'),
+}
+__all__ = list(_ENCODERS)
+
+
+def __getattr__(name):
+    if name not in _ENCODERS:
+        raise AttributeError(name)
+    module, attr = _ENCODERS[name]
+    value = getattr(import_module('.' + module, __name__), attr)
+    globals()[name] = value
+    return value
