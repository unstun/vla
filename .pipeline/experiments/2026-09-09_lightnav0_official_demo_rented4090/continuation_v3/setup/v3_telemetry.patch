@@ -0,0 +1,234 @@
+"""Opt-in observation-only capture recorder for the v3 visual-evidence continuation.
+
+Disabled unless ``LIGHTNAV_V3_TRACE_DIR`` is set. Nothing in this module changes
+robot stepping, MPC optimisation, camera settings, wire messages or control
+decisions: it only copies bytes and state that the demo already produced.
+
+Layout under the trace directory::
+
+    frames/front/front_<frame_id:08d>.jpg
+    frames/third/third_<frame_id:08d>.jpg
+    frames_index.jsonl        one row per captured pair
+    states.f64                fixed-size float64 records, append-only
+    traces.jsonl              request/response/consumption/control/lifecycle
+    recorder_status.json      written on close (and on demand)
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import queue
+import threading
+import time
+import uuid
+from pathlib import Path
+from typing import Any
+
+_ENV_DIR = "LIGHTNAV_V3_TRACE_DIR"
+_QUEUE_MAX = int(os.environ.get("LIGHTNAV_V3_QUEUE_MAX", "2048"))
+
+
+class _Recorder:
+    def __init__(self, root: Path) -> None:
+        self.root = root
+        self.run_uuid = str(uuid.uuid4())
+        self.front_dir = root / "frames" / "front"
+        self.third_dir = root / "frames" / "third"
+        self.front_dir.mkdir(parents=True, exist_ok=True)
+        self.third_dir.mkdir(parents=True, exist_ok=True)
+        self._queue: queue.Queue[Any] = queue.Queue(maxsize=_QUEUE_MAX)
+        self._id_lock = threading.Lock()
+        self._next_frame_id = 0
+        self._names: set[str] = set()
+        self.state_size: int | None = None
+        self.stats = {
+            "enqueued_frames": 0,
+            "enqueued_traces": 0,
+            "written_frames": 0,
+            "written_traces": 0,
+            "queue_drops": 0,
+            "write_failures": 0,
+            "duplicate_names": 0,
+            "malformed_rows": 0,
+            "enqueue_ns": [],
+        }
+        self._index = (root / "frames_index.jsonl").open("a", buffering=1)
+        self._traces = (root / "traces.jsonl").open("a", buffering=1)
+        self._states = (root / "states.f64").open("ab", buffering=0)
+        self._stop = threading.Event()
+        self._thread = threading.Thread(target=self._writer, name="v3-capture", daemon=True)
+        self._thread.start()
+
+    # ---------- producer side (must stay fast, never block the caller) ----------
+
+    def next_frame_id(self) -> int:
+        with self._id_lock:
+            value = self._next_frame_id
+            self._next_frame_id += 1
+            return value
+
+    def submit_frame(self, payload: dict) -> None:
+        t0 = time.monotonic_ns()
+        try:
+            self._queue.put_nowait(("frame", payload))
+            self.stats["enqueued_frames"] += 1
+        except queue.Full:
+            self.stats["queue_drops"] += 1
+        dt = time.monotonic_ns() - t0
+        samples = self.stats["enqueue_ns"]
+        if len(samples) < 100000:
+            samples.append(dt)
+
+    def trace(self, kind: str, **fields: Any) -> None:
+        row = {"trace": kind, "run_uuid": self.run_uuid, "mono_ns": time.monotonic_ns(),
+               "wall_unix": time.time(), **fields}
+        try:
+            self._queue.put_nowait(("trace", row))
+            self.stats["enqueued_traces"] += 1
+        except queue.Full:
+            self.stats["queue_drops"] += 1
+
+    # ---------- writer thread ----------
+
+    def _writer(self) -> None:
+        while True:
+            try:
+                item = self._queue.get(timeout=0.2)
+            except queue.Empty:
+                if self._stop.is_set():
+                    return
+                continue
+            kind, payload = item
+            try:
+                if kind == "frame":
+                    self._write_frame(payload)
+                else:
+                    self._traces.write(json.dumps(payload) + "\n")
+                    self.stats["written_traces"] += 1
+            except Exception as exc:  # recording failure, never silent
+                self.stats["write_failures"] += 1
+                try:
+                    self._traces.write(json.dumps({
+                        "trace": "recorder_failure", "run_uuid": self.run_uuid,
+                        "mono_ns": time.monotonic_ns(), "error": f"{type(exc).__name__}: {exc}",
+                        "kind": kind,
+                    }) + "\n")
+                except Exception:
+                    pass
+
+    def _exclusive_write(self, path: Path, data: bytes) -> None:
+        if path.name in self._names:
+            self.stats["duplicate_names"] += 1
+            raise FileExistsError(f"duplicate capture file name {path.name}")
+        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
+        fd = os.open(path, flags, 0o644)
+        try:
+            os.write(fd, data)
+        finally:
+            os.close(fd)
+        self._names.add(path.name)
+
+    def _write_frame(self, payload: dict) -> None:
+        frame_id = payload["frame_id"]
+        front_name = f"front_{frame_id:08d}.jpg"
+        third_name = f"third_{frame_id:08d}.jpg"
+        front_jpeg = payload.pop("_front_jpeg")
+        third_jpeg = payload.pop("_third_jpeg")
+        state = payload.pop("_state")
+        self._exclusive_write(self.front_dir / front_name, front_jpeg)
+        self._exclusive_write(self.third_dir / third_name, third_jpeg)
+        if self.state_size is None:
+            self.state_size = len(state)
+        if len(state) != self.state_size:
+            self.stats["malformed_rows"] += 1
+            raise ValueError("state record size changed mid-run")
+        offset = self._states.tell()
+        self._states.write(state)
+        row = {
+            "run_uuid": self.run_uuid,
+            "frame_id": frame_id,
+            "front_file": f"frames/front/{front_name}",
+            "third_file": f"frames/third/{third_name}",
+            "front_sha256": hashlib.sha256(front_jpeg).hexdigest(),
+            "third_sha256": hashlib.sha256(third_jpeg).hexdigest(),
+            "front_bytes": len(front_jpeg),
+            "third_bytes": len(third_jpeg),
+            "state_offset": offset,
+            "state_bytes": len(state),
+            **payload,
+        }
+        self._index.write(json.dumps(row) + "\n")
+        self.stats["written_frames"] += 1
+
+    # ---------- status / shutdown ----------
+
+    def status(self) -> dict:
+        samples = sorted(self.stats["enqueue_ns"])
+        percentile = (samples[int(len(samples) * 0.95)] if samples else None)
+        return {
+            "run_uuid": self.run_uuid,
+            "root": str(self.root),
+            "state_size_bytes": self.state_size,
+            "queue_max": _QUEUE_MAX,
+            "queue_depth": self._queue.qsize(),
+            **{k: v for k, v in self.stats.items() if k != "enqueue_ns"},
+            "enqueue_samples": len(samples),
+            "enqueue_p95_ns": percentile,
+            "enqueue_max_ns": (samples[-1] if samples else None),
+        }
+
+    def flush(self, timeout: float = 10.0) -> None:
+        deadline = time.monotonic() + timeout
+        while not self._queue.empty() and time.monotonic() < deadline:
+            time.sleep(0.02)
+        self._index.flush()
+        self._traces.flush()
+        self._states.flush()
+        (self.root / "recorder_status.json").write_text(
+            json.dumps(self.status(), indent=2) + "\n"
+        )
+
+    def close(self) -> None:
+        self.flush()
+        self._stop.set()
+        self._thread.join(timeout=5.0)
+        for handle in (self._index, self._traces, self._states):
+            try:
+                handle.close()
+            except Exception:
+                pass
+
+
+_RECORDER: _Recorder | None = None
+_INIT_LOCK = threading.Lock()
+
+
+def recorder() -> _Recorder | None:
+    """Return the process recorder, creating it on first use when enabled."""
+    global _RECORDER
+    if _RECORDER is not None:
+        return _RECORDER
+    target = os.environ.get(_ENV_DIR, "").strip()
+    if not target:
+        return None
+    with _INIT_LOCK:
+        if _RECORDER is None:
+            _RECORDER = _Recorder(Path(target))
+            _RECORDER.trace("recorder_start", pid=os.getpid())
+    return _RECORDER
+
+
+def enabled() -> bool:
+    return recorder() is not None
+
+
+def trace(kind: str, **fields: Any) -> None:
+    rec = recorder()
+    if rec is not None:
+        rec.trace(kind, **fields)
+
+
+def sha256_hex(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
