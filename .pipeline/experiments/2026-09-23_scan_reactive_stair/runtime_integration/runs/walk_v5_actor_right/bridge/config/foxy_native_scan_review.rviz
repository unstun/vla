Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: SCAN Layers
    Property Tree Widget:
      Expanded:
        - /Static Global Cloud1
        - /Live LiDAR Cloud1
        - /Raw SCAN Occupancy1
        - /Inflated Safety Occupancy (transparent)1
        - /Lite3 URDF (measured joints)1
        - /Current Lite3 Position (live pose)1
        - /SCAN Planned Path (B-spline)1
        - /Lite3 Actual Path (body pose)1
      Splitter Ratio: 0.56
    Tree Height: 1180
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: View
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.25
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 100; 100; 105
      Enabled: true
      Line Style:
        Line Width: 0.02
        Value: Lines
      Name: World Ground Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 50
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      Mass: false
      Name: Lite3 URDF (measured joints)
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.6000000000000001
      Name: Current Lite3 Pose (TORSO)
      Radius: 0.035
      Reference Frame: TORSO
      Value: true
    - Alpha: 1
      Axes Length: 0.7
      Axes Radius: 0.08
      Class: rviz_default_plugins/Pose
      Color: 255; 230; 25
      Enabled: true
      Head Length: 0.35
      Head Radius: 0.16
      Name: Current Lite3 Position (live pose)
      Shaft Length: 0.65
      Shaft Radius: 0.07
      Shape: Arrow
      Topic:
        Depth: 10
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /review/lite3_current_pose
      Value: true
    - Alpha: 0.28
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 20
        Min Value: -20
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 145; 145; 150
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Static Global Cloud
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 1
      Size (m): 0.009999999776482582
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map_generator/global_cloud
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 2.2
        Min Value: -0.2
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 80; 225; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Live LiDAR Cloud
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.014999999664723873
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /quad_0/cloud_raw
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Alpha: 0.80000000000000004
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 0.7
        Min Value: -0.15
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 70; 255; 125
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Raw SCAN Occupancy
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.02500000037252903
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /grid_map/occupancy
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Alpha: 0.14000000000000001
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 0.7
        Min Value: -0.55
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 85; 215
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Inflated Safety Occupancy (transparent)
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 1
      Size (m): 0.019999999552965164
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /grid_map/occupancy_inflate
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Sliding Map Bounds
      Namespaces:
        sliding_map: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /grid_map/sliding_map_bbox
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 40; 255; 30
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.11000000000000001
      Name: Lite3 Actual Path (body pose)
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Depth: 10
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /review/lite3_actual_path
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 75; 25
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.14000000000000001
      Name: SCAN Planned Path (B-spline)
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /review/scan_planned_path
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Sparse Waypoints / Final Goal
      Namespaces:
        "": true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_point
      Value: true
  Enabled: true
  Global Options:
    Background Color: 24; 26; 31
    Fixed Frame: world
    Frame Rate: 30
  Name: Native SCAN Review
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 255; 255; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12.5
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.3
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Office L0 Start Region
      Near Clip Distance: 0.01
      Pitch: 0.72
      Target Frame: TORSO
      Value: Orbit (rviz_default_plugins)
      Yaw: 2.35
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1371
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 2428
  X: 132
  Y: 54
