<?xml version="1.0"?>
<package format="3">
  <name>scan_reactive_tracker</name>
  <version>0.1.0</version>
  <description>Candidate current moving-cluster tracks from synchronized LiDAR and pose.</description>
  <maintainer email="sun@machine-dog.local">Lite3 VLA Research</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>scan_planner_msgs</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
