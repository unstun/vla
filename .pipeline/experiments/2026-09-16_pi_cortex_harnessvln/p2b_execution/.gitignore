# Exact local-only scene/map bytes. Provenance, hashes and regeneration are
# tracked in input_manifest.json and freeze_inputs.py.
/inputs/building.usda
/inputs/new_building.pickle
# Exact native ABI and materialized pinned Python source. See
# pct_runtime_manifest.json and freeze_pct_runtime.py for every hash/source.
/pct_runtime/
# Materialized pinned SCAN plus explicit adapter patches; per-build
# overlay_manifest.json records every resulting source hash.
/builds/*/src/
__pycache__/
