Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Live Point Cloud1
        - /Unmapped Box AABB Hits1
      Splitter Ratio: 0.52
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: World Grid
      Enabled: true
      Value: true
      Alpha: 0.3
      Cell Size: 1
      Color: 120; 130; 145
      Line Style:
        Line Width: 0.02
        Value: Lines
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 1.56
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/PointCloud2
      Name: Live Point Cloud
      Enabled: true
      Value: true
      Alpha: 1
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds:
        Max Value: 3.2
        Min Value: 1.5
        Value: true
      Invert Rainbow: false
      Decay Time: 0
      Style: Points
      Size (Pixels): 2
      Size (m): 0.02
      Selectable: false
      Use Fixed Frame: true
      Topic:
        Value: /quad_0/cloud_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
        Filter size: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Unmapped Box AABB Hits
      Enabled: true
      Value: true
      Namespaces:
        {}
      Topic:
        Value: /review/unmapped_box_hits
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
        Filter size: 1
    - Class: rviz_default_plugins/Odometry
      Name: Current Robot Pose
      Enabled: true
      Value: true
      Keep: 1
      Angle Tolerance: 0
      Position Tolerance: 0
      Topic:
        Value: /quad_0/body_pose
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
        Filter size: 1
      Shape:
        Value: Arrow
        Alpha: 1
        Color: 255; 195; 40
        Head Length: 0.2
        Head Radius: 0.1
        Shaft Length: 0.45
        Shaft Radius: 0.04
      Covariance:
        Value: false
  Global Options:
    Background Color: 20; 27; 37
    Fixed Frame: world
    Frame Rate: 10
  Name: Live Point-Cloud Observer
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Focal Point:
        X: 0.4
        Y: -4.5
        Z: 1.8
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Name: Building Point Cloud
      Near Clip Distance: 0.01
      Pitch: 0.9
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.85
    Saved: ~
Window Geometry:
  Height: 760
  Width: 1200
  X: 40
  Y: 40
  Hide Left Dock: false
  Hide Right Dock: true
