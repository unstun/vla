+def _stance_smoothstep(progress: float) -> float:
+    """MJ _motion_smoothstep (MJ:1233-1236)."""
+    progress = float(np.clip(progress, 0.0, 1.0))
+    return progress * progress * (3.0 - 2.0 * progress)
