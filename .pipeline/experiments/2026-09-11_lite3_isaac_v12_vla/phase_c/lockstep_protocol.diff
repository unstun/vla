> # ---------------------------------------------------------------------------------------------------------------------
> # Task-owned additions (09-11-internvla-n1-lite3-isaac-sim, Phase C, 2026-09-14). Everything above this line is the
> # pinned lite3_sim_bridge protocol.py, byte-identical except the two MessageType members; see PROTOCOL_COPY.md.
> #
> # Lockstep (design Decision 5): the client sends one CMD_VEL_V1 followed by one STEP_REQUEST_V1; the simulator applies
> # the command through LatestCommandState, advances duration_ns of simulated time, and replies STATUS_V1, BODY_STATE_V2
> # and, if requested, IMAGE_FRAME_V1. The simulator never advances without a request.
> # ---------------------------------------------------------------------------------------------------------------------
> 
> # frame id, simulation time ns, width, height, rgb format, depth format, fx, fy, cx, cy,
> # camera position world xyz, camera orientation world xyzw, rgb byte length, depth byte length
> IMAGE_FRAME_V1_PREFIX_STRUCT = struct.Struct("!QQIIHH4d3d4dII")
> RGB_FORMAT_RGB8 = 1
> DEPTH_FORMAT_F32LE_METRES = 1
> MAX_IMAGE_WIDTH = 4096
> MAX_IMAGE_HEIGHT = 4096
> 
> # duration ns, request id, want image, end episode, reserved
> STEP_REQUEST_V1_STRUCT = struct.Struct("!QIBBH")
> MAX_STEP_DURATION_NS = 10_000_000_000
