> def decode_step_request_payload(payload: bytes) -> StepRequestV1:
>     if len(payload) != STEP_REQUEST_V1_STRUCT.size:
>         raise ProtocolError("step request payload has the wrong size")
>     duration_ns, request_id, want_image, end_episode, reserved = STEP_REQUEST_V1_STRUCT.unpack(payload)
>     if want_image not in (0, 1) or end_episode not in (0, 1) or reserved != 0:
>         raise ProtocolError("step request flags are invalid")
>     if duration_ns > MAX_STEP_DURATION_NS:
