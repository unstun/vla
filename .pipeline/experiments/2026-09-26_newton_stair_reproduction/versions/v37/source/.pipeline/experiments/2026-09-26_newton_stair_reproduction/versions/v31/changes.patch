+  template <typename Callback>
+  int takePendingOdometry(const rclcpp::Subscription<nav_msgs::msg::Odometry>::SharedPtr &subscription,
+                          const rclcpp::Logger &logger, Callback &&callback)
+  {
+    int applied = 0;
+    rclcpp::MessageInfo info;
