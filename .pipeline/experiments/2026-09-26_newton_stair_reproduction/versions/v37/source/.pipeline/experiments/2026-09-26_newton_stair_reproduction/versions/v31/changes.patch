+      catch (const rclcpp::exceptions::RCLError &error)
+      {
+        RCLCPP_ERROR(logger, "input_refresh take from body_pose (fsm) failed: %s", error.what());
+        break;
+      }
+      callback(message);
+      ++applied;
+    }
+    return applied;
   }
