+def load_recorded_rows(source):
+    """Display-only 30 FPS sampling; retain actual logged poses without interpolation."""
+    original = json.loads((source / "video_states.json").read_text())
+    times = np.asarray([row["physics_time_s"] for row in original])
+    if len(times) < 2 or not np.isfinite(times).all() or np.any(np.diff(times) <= 0.):
+        raise ValueError("Expected strictly increasing actual recorded native times")
+    display = times[0] + np.arange(int(np.floor((times[-1]-times[0])*30.))+1) / 30.
+    indices = np.searchsorted(times, display).clip(1, len(times)-1)
+    indices -= np.abs(times[indices-1]-display) <= np.abs(times[indices]-display)
+    return [dict(original[int(i)], display_time_s=float(t)) for i,t in zip(indices,display)]
+
+
