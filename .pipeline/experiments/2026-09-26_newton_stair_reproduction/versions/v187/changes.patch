+TEST_F(PluginTest, TerminalTimeoutRevokesOwnerAndFailsFollowPath)
+{
+  auto *actual=dynamic_cast<scan_nav2_controller::Controller *>(plugin.get());
+  ASSERT_NE(actual,nullptr);
+  actual->tracker_->terminal_correction_enabled_=true;
+  actual->tracker_->finish_dist_=.02;
+  std::vector<sm::P2BCancel> revoked;
+  auto subscription=io->create_subscription<sm::P2BCancel>("/p2b/scan_cancel",10,
+    [&](sm::P2BCancel::ConstSharedPtr message){revoked.push_back(*message);});
+  plan();auto m=curve();
+  for(size_t i=0;i<m.pos_pts.size();++i)m.pos_pts[i].x=i<3?0.0:.05;
+  spline->publish(m);
+  ASSERT_TRUE(wait([&]{sendSafety();plugin->computeVelocityCommands(pose(),geometry_msgs::msg::Twist());return actual->tracker_->receive_traj_;}));
+  actual->tracker_->exec_time_=actual->tracker_->traj_duration_;
+  actual->tracker_->last_update_time_=actual->tracker_->now();
+  auto command=plugin->computeVelocityCommands(pose(.025),geometry_msgs::msg::Twist());
+  ASSERT_GT(command.twist.linear.x,0.0);
+  actual->tracker_->terminal_correction_since_=actual->tracker_->now()-rclcpp::Duration::from_seconds(1.6);
+  try {
+    plugin->computeVelocityCommands(pose(.025),geometry_msgs::msg::Twist());
+    FAIL()<<"Terminal correction falsely returned normal success";
+  } catch(const nav2_core::PlannerException &error) {
+    EXPECT_STREQ(error.what(),"scan_terminal_correction_timeout");
+  }
+  ASSERT_TRUE(wait([&]{return !revoked.empty()&&!received.empty()&&received.back().twist==geometry_msgs::msg::Twist();}));
+  EXPECT_EQ(revoked.back().reason,"scan_terminal_correction_timeout");
+  EXPECT_EQ(revoked.back().command_id,route.command_id);
+  EXPECT_FALSE(actual->tracker_->receive_traj_);
+  EXPECT_FALSE(goal->isGoalReached(pose(.025).pose,route.goal_pose,geometry_msgs::msg::Twist()));
+}
