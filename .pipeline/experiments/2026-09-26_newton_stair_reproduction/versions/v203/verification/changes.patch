diff -ruN --exclude=__pycache__ parent-v202/src/lite3_nav2_bridge/lite3_nav2_bridge/static_terrain.py v203/src/lite3_nav2_bridge/lite3_nav2_bridge/static_terrain.py
--- parent-v202/src/lite3_nav2_bridge/lite3_nav2_bridge/static_terrain.py	1969-12-31 16:00:00
+++ v203/src/lite3_nav2_bridge/lite3_nav2_bridge/static_terrain.py	2026-10-15 01:28:21
@@ -0,0 +1,66 @@
+"""Publish all static terrain roles from one loaded, immutable package."""
+import rclpy
+from rclpy.executors import ExternalShutdownException
+from rclpy.node import Node
+from rclpy.qos import QoSProfile, QoSReliabilityPolicy, QoSDurabilityPolicy, qos_profile_sensor_data
+from rosgraph_msgs.msg import Clock
+from sensor_msgs.msg import PointCloud2, PointField
+
+from .terrain_bundle import TerrainBundle, ClockGate, TOPICS, FIELDS
+
+
+class StaticTerrain(Node):
+    def __init__(self, **kwargs):
+        super().__init__('static_terrain', **kwargs)
+        self.bundle = TerrainBundle(self.declare_parameter('terrain_manifest', '').value)
+        self.gate = ClockGate()
+        self.messages, self.publishers_by_role = {}, {}
+        qos = QoSProfile(depth=1, reliability=QoSReliabilityPolicy.RELIABLE,
+                         durability=QoSDurabilityPolicy.TRANSIENT_LOCAL)
+        for role, data in self.bundle.load_clouds().items():
+            message = PointCloud2()
+            message.header.frame_id = self.bundle.metadata['frame']
+            message.height = 1
+            message.width = len(data) // 16
+            message.point_step, message.row_step = 16, len(data)
+            message.is_bigendian = message.is_dense = False
+            message.fields = [PointField(name=n, offset=o, datatype=t, count=c) for n, o, t, c in FIELDS]
+            message.data = data
+            self.messages[role] = message
+            self.publishers_by_role[role] = self.create_publisher(PointCloud2, TOPICS[role], qos)
+        if self.get_parameter('use_sim_time').value:
+            self.create_subscription(Clock, '/clock', self.on_clock, qos_profile_sensor_data)
+        else:
+            self.wall_timer = self.create_timer(0.1, self.on_wall_time)
+        self.get_logger().info('Loaded one static terrain package: ' + str(self.bundle.path))
+
+    def on_clock(self, clock):
+        self.publish_at(int(clock.clock.sec) * 1000000000 + int(clock.clock.nanosec))
+
+    def on_wall_time(self):
+        if self.publish_at(self.get_clock().now().nanoseconds()):
+            self.wall_timer.cancel()
+
+    def publish_at(self, clock_ns):
+        stamp = self.gate.observe(clock_ns)
+        if stamp is None:
+            return False
+        for role, message in self.messages.items():
+            message.header.stamp.sec, message.header.stamp.nanosec = divmod(stamp, 1000000000)
+            self.publishers_by_role[role].publish(message)
+        return True
+
+
+def main():
+    rclpy.init()
+    node = None
+    try:
+        node = StaticTerrain()
+        rclpy.spin(node)
+    except (KeyboardInterrupt, ExternalShutdownException):
+        pass
+    finally:
+        if node is not None:
+            node.destroy_node()
+        if rclpy.ok():
+            rclpy.shutdown()
diff -ruN --exclude=__pycache__ parent-v202/src/lite3_nav2_bridge/lite3_nav2_bridge/terrain_bundle.py v203/src/lite3_nav2_bridge/lite3_nav2_bridge/terrain_bundle.py
--- parent-v202/src/lite3_nav2_bridge/lite3_nav2_bridge/terrain_bundle.py	1969-12-31 16:00:00
+++ v203/src/lite3_nav2_bridge/lite3_nav2_bridge/terrain_bundle.py	2026-10-15 01:28:21
@@ -0,0 +1,113 @@
+"""One manifest for distinct static navigation, surface and physical-floor roles."""
+import hashlib
+import json
+import math
+from pathlib import Path
+
+import numpy as np
+
+TOPICS = {'navigation': '/pct_tomogram', 'surface': '/pct_ground_surface',
+          'physical_floor': '/pct_physical_floor'}
+FIELDS = (('x', 0, 7, 1), ('y', 4, 7, 1), ('z', 8, 7, 1), ('intensity', 12, 7, 1))
+
+
+def fnv64(data):
+    value = 14695981039346656037
+    for byte in data:
+        value = ((value ^ byte) * 1099511628211) & 0xffffffffffffffff
+    return str(value)
+
+
+class TerrainBundle:
+    """Read metadata once; load cloud bytes once in the sole static publisher."""
+    def __init__(self, manifest):
+        self.path = Path(manifest).resolve(strict=True)
+        self.metadata = json.loads(self.path.read_text())
+        m = self.metadata
+        if m.get('format') != 'LITE3_TERRAIN_V1' or m.get('frame') != 'world':
+            raise ValueError('Unsupported static terrain format/frame')
+        if set(m['clouds']) != set(TOPICS) or m['support_gap'].get('negative_only') is not True:
+            raise ValueError('Static terrain roles must remain distinct')
+        if not math.isfinite(m['resolution']) or m['resolution'] <= 0 or \
+                not all(math.isfinite(x) for x in [*m['physical_origin'], m['z_offset']]) or \
+                len(m['physical_origin']) != 2:
+            raise ValueError('Invalid static terrain geometry')
+        for role, topic in TOPICS.items():
+            entry = m['clouds'][role]
+            if entry['topic'] != topic or entry['role'] != role or entry['points'] <= 0 or \
+                    entry['bytes'] != entry['points'] * 16:
+                raise ValueError('Invalid static cloud role/layout: ' + role)
+            self.file(entry)
+        self.file(m['pct']); self.file(m['support_gap'])
+        self._clouds = None
+
+    def file(self, entry):
+        return (self.path.parent / entry['file']).resolve(strict=True)
+
+    def checked_bytes(self, entry):
+        data = self.file(entry).read_bytes()
+        if len(data) != entry['bytes'] or hashlib.sha256(data).hexdigest() != entry['sha256']:
+            raise ValueError('Static terrain identity mismatch: ' + entry['file'])
+        return data
+
+    def load_clouds(self):
+        if self._clouds is None:
+            clouds = {}
+            for role, entry in self.metadata['clouds'].items():
+                data = self.checked_bytes(entry)
+                if not np.isfinite(np.frombuffer(data, dtype='<f4')).all():
+                    raise ValueError('Nonfinite static cloud: ' + role)
+                prefix = 'pct_physical_floor' if role == 'physical_floor' else 'pct_tomogram'
+                if entry['source_id'] != prefix + '/fnv64/' + fnv64(data):
+                    raise ValueError('Static cloud source ID mismatch: ' + role)
+                clouds[role] = data
+            self._clouds = clouds
+        return self._clouds
+
+    def native_parameters(self):
+        m = self.metadata
+        self.checked_bytes(m['pct'])
+        gap = self.checked_bytes(m['support_gap'])
+        if fnv64(gap) != m['support_gap']['fnv64']:
+            raise ValueError('Static support mask identity mismatch')
+        return {
+            'grid_map.support_gap_path': str(self.file(m['support_gap'])),
+            'grid_map.support_gap_fnv64': m['support_gap']['fnv64'],
+            'grid_map.reactive_surface_ground_topic': TOPICS['surface'],
+            'grid_map.reactive_physical_floor_topic': TOPICS['physical_floor'],
+            'grid_map.physical_floor_source_id': m['clouds']['physical_floor']['source_id'],
+            'grid_map.physical_floor_surface_source_id': m['clouds']['surface']['source_id'],
+            'grid_map.physical_floor_navigation_source_id': m['clouds']['navigation']['source_id'],
+            'grid_map.physical_floor_origin_x': m['physical_origin'][0],
+            'grid_map.physical_floor_origin_y': m['physical_origin'][1],
+            'grid_map.physical_floor_resolution': m['resolution'],
+            'grid_map.reactive_tomogram_resolution': m['resolution'],
+            'grid_map.reactive_tomogram_z_offset': m['z_offset'],
+        }
+
+
+class ClockGate:
+    """Unchanged two-advancing-positive-samples gate, rearmed by clock reset."""
+    def __init__(self):
+        self._first_positive_ns = None
+        self._last_ns = None
+        self._published = False
+
+    def observe(self, clock_ns):
+        if clock_ns <= 0:
+            if self._last_ns is not None and clock_ns < self._last_ns:
+                self._first_positive_ns = None
+                self._published = False
+            self._last_ns = clock_ns
+            return None
+        if self._last_ns is not None and clock_ns < self._last_ns:
+            self._first_positive_ns = None
+            self._published = False
+        self._last_ns = clock_ns
+        if self._first_positive_ns is None:
+            self._first_positive_ns = clock_ns
+            return None
+        if self._published or clock_ns <= self._first_positive_ns:
+            return None
+        self._published = True
+        return clock_ns
