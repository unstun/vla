+class AppliedStore:
+    """One atomic writer; duplicate requests can only read back its exact head."""
+    def __init__(self, out):
+        self.out = out
+        self.request = json.loads((out / "episode_request.json").read_text())
+        self.external = out / "artifacts/external_episode"
+        self.external.mkdir(parents=True, exist_ok=True)
+        self.last_sequence = -1
+        self.last_digest = None
+
+    def accept(self, raw):
+        from backend_adapter.applied_evidence import AppliedCommandSnapshot, AppliedEvidenceReader
+        snapshot = AppliedCommandSnapshot.from_mapping(json.loads(raw))
+        age = (time.monotonic_ns() - snapshot.wall_monotonic_ns) / 1e9
+        if snapshot.run_id != self.out.name or snapshot.run_epoch_ns != self.request["run_epoch_ns"]:
+            raise ValueError("Applied state run identity mismatch")
+        if not 0 <= age <= snapshot.max_reader_age_s:
+            raise ValueError("Applied state stale or future")
+        digest = hashlib.sha256(raw).hexdigest()
+        duplicate = snapshot.state_sequence == self.last_sequence
+        if snapshot.state_sequence < self.last_sequence or (duplicate and digest != self.last_digest):
+            raise ValueError("Applied state reordered or altered duplicate")
+        current = self.external / "current_command.json"
+        if not duplicate:
+            temporary = self.external / "current_command.json.tmp"
+            temporary.write_bytes(raw)
+            temporary.replace(current)
+            self.last_sequence, self.last_digest = snapshot.state_sequence, digest
+        elif not current.is_file() or hashlib.sha256(current.read_bytes()).hexdigest() != digest:
+            raise ValueError("Applied state read-back differs from committed bytes")
+        checked = AppliedEvidenceReader(current).read()
+        if checked.state_sequence != snapshot.state_sequence:
+            raise ValueError("Applied state reader sequence mismatch")
+        reply = {"ok": True, "sequence": snapshot.state_sequence, "sha256": digest,
+                 "receive_age_s": age, "linux_receive_ns": time.monotonic_ns(),
+                 "original_reader_sequence": checked.state_sequence, "duplicate": duplicate}
+        finish = self.external / "finish_request.json"
+        if finish.exists():
+            reply["finish_request"] = json.loads(finish.read_text())
+        return reply
+
