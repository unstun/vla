+bool GridMap::terrainSupportHeight(const Eigen::Vector3d &near, double &body_z) {
+  if(!near.allFinite())return false;
+  const auto &s=supportState();const auto &raw=s.reactive_ground_;const auto &scored=s.reactive_terrain_;
+  if(raw.source_id!=scored.source_id || raw.frame!=scored.frame || raw.resolution_m!=scored.resolution_m ||
+      raw.origin_x_m!=scored.origin_x_m || raw.origin_y_m!=scored.origin_y_m)return false;
+  reactive_stair::Cell2 cell;if(!supportQueryCell(near.x(),near.y(),cell))return false;
+  const auto layers=terrainCellLayers(cell);
+  if(!layers.raw || !layers.scored || layers.raw->size()!=layers.scored->size())return false;
+  const int layer=reactive_stair::nearestSurface(*layers.raw,near.z()-s.reactive_parameters_.body_clearance_m,
+      reactive_stair::StepScoreParameters{}.critical_height_m);
+  if(layer<0)return false;
+  const auto &surface=(*layers.scored)[layer];
+  if(surface.elevation_m!=(*layers.raw)[layer].elevation_m || !reactive_stair::selectedSurface(surface))return false;
+  if(mapState().mp_.support_gap_mask_ && mapState().mp_.support_gap_mask_->blocks(near.x(),near.y(),surface.elevation_m))return false;
+  body_z=surface.elevation_m+s.reactive_parameters_.body_clearance_m;return std::isfinite(body_z);
 }
 
