+bool GridMap::bodyEndpointMayBeObserved(const Eigen::Vector3d &point) {
+  const double offset = std::abs(mp_.double_cylinder_offset_);
+  const double resolution = mp_.resolution_;
+  if (!point.allFinite() || point.cwiseAbs().maxCoeff() > 1e6 ||
+      !std::isfinite(offset) || !std::isfinite(resolution) || resolution <= 0.0 ||
+      !std::isfinite(mp_.double_cylinder_radius_) || mp_.double_cylinder_radius_ < 0.0 ||
+      !std::isfinite(mp_.clamp_min_log_) || md_.occupancy_buffer_.empty()) return true;
+  // The existing measured-footprint waiver can admit unknown space beside the
+  // robot. Keep every possibly waived endpoint, even with stale/invalid pose.
+  // A 1 m margin strictly encloses its [-0.05, 0.10854] m vertical slice.
+  if (reactive_known_trunk_enabled_ &&
+      (!md_.sliding_map_frame_pos_.allFinite() || !reactive_body_quaternion_.coeffs().allFinite() ||
+       std::abs(reactive_body_quaternion_.squaredNorm() - 1.0) > 1e-6 ||
+       (point - md_.sliding_map_frame_pos_).norm() <=
+           2.0 * offset + mp_.double_cylinder_radius_ + 1.0)) return true;
+  // Every yaw puts both cylinder centers inside this square at the same Z.
+  // Expand by a cell for numerical boundaries. Any observed voxel, including
+  // occupied ones, keeps the search: only all-unknown evidence can reject.
+  const Eigen::Vector3d extent(offset + resolution, offset + resolution, resolution);
+  Eigen::Vector3i lower, upper;
+  posToIndex(point - extent, lower);
+  posToIndex(point + extent, upper);
+  lower = lower.cwiseMax(mp_.map_bound_min_idx_);
+  upper = upper.cwiseMin(mp_.map_bound_max_idx_);
+  if ((lower.array() > upper.array()).any()) return false;
+  const Eigen::Vector3d sizes = (upper - lower + Eigen::Vector3i::Ones()).cast<double>();
+  if (sizes.prod() > 1000000.0) return true;
+  for (int x = lower.x(); x <= upper.x(); ++x)
+    for (int y = lower.y(); y <= upper.y(); ++y)
+      for (int z = lower.z(); z <= upper.z(); ++z) {
+        const double occupancy = md_.occupancy_buffer_[toAddress(Eigen::Vector3i(x, y, z))];
+        if (!std::isfinite(occupancy) || occupancy >= mp_.clamp_min_log_ - 1e-3) return true;
+      }
+  return false;
+}
