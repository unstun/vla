<root main_tree_to_execute="MainTree">
 <BehaviorTree ID="MainTree">
  <RecoveryNode number_of_retries="6" name="NavigateRecovery">
   <Sequence name="NavigateWithDirectRoute">
    <ComputePathToPose goal="{goal}" path="{path}" planner_id="PCT" server_name="/compute_path_to_pose" server_timeout="1000"/>
    <FollowPath path="{path}" controller_id="SCAN" server_name="/follow_path" server_timeout="1000"/>
   </Sequence>
   <Wait wait_duration="0.1" server_name="/wait" server_timeout="1000"/>
  </RecoveryNode>
 </BehaviorTree>
</root>
