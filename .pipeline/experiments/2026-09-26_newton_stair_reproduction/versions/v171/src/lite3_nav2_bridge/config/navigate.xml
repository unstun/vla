<root main_tree_to_execute="MainTree">
 <BehaviorTree ID="MainTree">
  <MeasuredProgressRecovery number_of_retries="6" name="NavigateWithMeasuredStop">
   <Sequence>
    <Fallback>
     <Sequence>
      <ComputePathToPose goal="{goal}" path="{path}" planner_id="PCT" server_name="/compute_path_to_pose" server_timeout="1000"/>
      <RememberGlobalPath goal="{goal}" path="{path}"/>
     </Sequence>
     <RestoreGlobalPath goal="{goal}" path="{path}"/>
    </Fallback>
    <BindScanRoute goal="{goal}" path="{path}" bound_path="{bound_path}"/>
    <FollowPath path="{bound_path}" controller_id="SCAN" server_name="/follow_path" server_timeout="1000"/>
   </Sequence>
   <WaitForScanStop/>
  </MeasuredProgressRecovery>
 </BehaviorTree>
</root>
