+  auto future=pose();future.header.stamp=rclcpp::Time(19200000000LL,RCL_ROS_TIME);
+  EXPECT_THROW(plugin->computeVelocityCommands(future,geometry_msgs::msg::Twist()),nav2_core::PlannerException);
