<?xml version="1.0"?>
<package format="3">
  <name>scan_nav2_controller</name>
  <version>0.1.0</version>
  <description>Foxy Nav2 controller and goal checker for the pinned Lite3 SCAN runtime.</description>
  <maintainer email="research@example.invalid">Lite3 VLA project</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rcl_yaml_param_parser</depend>
  <depend>scan_planner</depend>
  <depend>nav2_core</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>bspline_opt</depend>
  <depend>scan_planner_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
