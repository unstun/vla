+  void SCANReplanFSM::callbackFailed(const char *site) noexcept {
+    // Retain the mission/route for ordinary retries, but discard partial work.
+    try {planner_manager_->publication_lease_.reset();}catch (...) {}
+    try {planner_manager_->invalidateWarmStart();}catch (...) {}
+    feasible_window_.valid=false;
+    if(planner_manager_)planner_manager_->local_data_.duration_=0.;
+    if(have_target_)exec_state_=GEN_NEW_TRAJ;
+    else exec_state_=have_odom_ ? WAIT_TARGET : INIT;
+    ++replan_fail_count_;
+    scan_runtime::callbackBoundary(node_->get_logger(),"callback_failure_notification",[&]{
+      if(direct_io_.planning_result)direct_io_.planning_result(false,node_->now().nanoseconds());
+      if(have_odom_ && odom_pos_.allFinite())callEmergencyStop(odom_pos_);
+      RCLCPP_WARN(node_->get_logger(),"native_local_round_failed site=%s",site);
+    },[]{});
   }
 
