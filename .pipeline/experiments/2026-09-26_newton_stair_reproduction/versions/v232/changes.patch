+TEST(NativeCallbackBoundary, FoxyTwoThreadsContainTimerServiceAndCleanupExceptions) {
+ int argc=0;rclcpp::init(argc,nullptr);
+ {
+  auto node=std::make_shared<rclcpp::Node>("callback_exception_boundary");
+  scan_planner::SCANReplanFSM fsm;fsm.node_=node.get();fsm.have_target_=true;fsm.have_odom_=false;
+  fsm.replan_fail_count_=0;fsm.planner_manager_=std::make_unique<scan_planner::SCANPlannerManager>();
+  std::atomic<int> failures{0},ticks{0},work_calls{0};
+  fsm.direct_io_.planning_result=[&](bool success,int64_t){EXPECT_FALSE(success);++failures;};
+  fsm.direct_io_.before_work=[&]{if(++work_calls%2)throw std::runtime_error("injected timer failure");throw 7;};
+  auto work=node->create_callback_group(rclcpp::CallbackGroupType::MutuallyExclusive);
+  auto query=node->create_callback_group(rclcpp::CallbackGroupType::MutuallyExclusive);
+  auto timer=node->create_wall_timer(std::chrono::milliseconds(2),[&]{
+    fsm.callbackBoundary("execFSMCallback",[&]{fsm.execFSMCallback();});
+  },work);
+  auto heartbeat=node->create_wall_timer(std::chrono::milliseconds(1),[&]{++ticks;});
+  using Service=lite3_nav2_interfaces::srv::CheckTraversability;
+  std::atomic<int> calls{0};
+  auto service=node->create_service<Service>("/callback_boundary_query",[&](
+      const std::shared_ptr<Service::Request>,std::shared_ptr<Service::Response> response){
+    scan_nav2_controller::nativeQueryCallback(node->get_logger(),*response,[&]{
+      response->ready=true;response->verdicts.push_back(0);
+      if(++calls==1)throw std::runtime_error("injected service failure after partial response");
+    });
+  },rmw_qos_profile_services_default,query);
+  auto client=node->create_client<Service>("/callback_boundary_query");
+  rclcpp::executors::MultiThreadedExecutor executor(rclcpp::ExecutorOptions(),2);
+  executor.add_node(node);std::thread thread([&]{executor.spin();});
+  const bool ready=client->wait_for_service(std::chrono::seconds(3));EXPECT_TRUE(ready);
+  if(ready){
+    auto first=client->async_send_request(std::make_shared<Service::Request>());
+    EXPECT_EQ(first.wait_for(std::chrono::seconds(3)),std::future_status::ready);
+    if(first.wait_for(std::chrono::seconds(0))==std::future_status::ready){
+      EXPECT_FALSE(first.get()->ready);EXPECT_TRUE(first.get()->verdicts.empty());
+      EXPECT_EQ(first.get()->message,"native_query_exception");
+    }
+    auto second=client->async_send_request(std::make_shared<Service::Request>());
+    EXPECT_EQ(second.wait_for(std::chrono::seconds(3)),std::future_status::ready);
+    if(second.wait_for(std::chrono::seconds(0))==std::future_status::ready)EXPECT_TRUE(second.get()->ready);
+  }
+  std::this_thread::sleep_for(std::chrono::milliseconds(30));
+  executor.cancel();thread.join();
+  EXPECT_GT(failures.load(),1);EXPECT_GT(ticks.load(),1);
+  EXPECT_GT(fsm.replan_fail_count_,1);EXPECT_EQ(fsm.exec_state_,scan_planner::SCANReplanFSM::GEN_NEW_TRAJ);
+  EXPECT_FALSE(scan_runtime::callbackBoundary(node->get_logger(),"double_exception",[]{throw 3;},[]{throw 4;}));
