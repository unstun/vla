{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"nl -ba .pipeline/experiments/2026-09-26_newton_stair_reproduction/runtime/scan65_evidence_floor_v34/src/plan_env/include/plan_env/evidence_floor_fill.h\nnl -ba .pipeline/experiments/2026-09-26_newton_stair_reproduction/runtime/scan65_evidence_floor_v34/src/plan_env/include/plan_env/scan_reactive_grid_methods.inc | sed -n '1,310p'\"","aggregated_output":"     1\t#ifndef P2B_EVIDENCE_FLOOR_FILL_H\n     2\t#define P2B_EVIDENCE_FLOOR_FILL_H\n     3\t\n     4\t// v34 (Dr Sun, 2026-09-29; audits/2026-09-29_corridor_entry). SCAN's footprint\n     5\t// support reads PCT's navigation ground, which PCT trims by its obstacle-distance\n     6\t// inflation. The surface evidence is PCT's uninflated selection of the same\n     7\t// ground. Where the navigation cell containing an evidence cell's centre has no\n     8\t// layer within tolerance_m of an evidence layer, the returned ground gains that\n     9\t// layer, unless a drop lies within guard_radius_m: an evidence cell whose square\n    10\t// comes within guard_radius_m of the candidate's square, with no surface within\n    11\t// step_m of the layer and either no surface at all or one more than step_m below\n    12\t// it. A cell with only higher surfaces is solid (a wall under an upper floor);\n    13\t// LiDAR occupancy still decides obstacles. Navigation layers are never changed or\n    14\t// removed. Unusable evidence adds nothing, as it scores exactly as without\n    15\t// evidence in the step score (v30).\n    16\t#include <plan_env/reactive_collision.h>\n    17\t\n    18\t#include <algorithm>\n    19\t#include <cmath>\n    20\t#include <cstddef>\n    21\t#include <limits>\n    22\t#include <vector>\n    23\t\n    24\tnamespace reactive_stair {\n    25\t\n    26\tstruct EvidenceFloorFill {\n    27\t  bool evidence_used = false;\n    28\t  std::size_t added = 0;          // evidence layers added to the navigation ground\n    29\t  std::size_t drop_rejected = 0;  // candidates rejected because a drop lies within the guard\n    30\t};\n    31\t\n    32\tinline bool evidenceFillIndex(double coordinate, double origin, double resolution, int &index) {\n    33\t  const double value = std::floor((coordinate - origin) / resolution);\n    34\t  if (!std::isfinite(value) || value < std::numeric_limits<int>::min() ||\n    35\t      value > std::numeric_limits<int>::max()) return false;\n    36\t  index = static_cast<int>(value);\n    37\t  return true;\n    38\t}\n    39\t\n    40\tinline TerrainSnapshot addGuardedEvidenceFloor(const TerrainSnapshot &navigation,\n    41\t                                               const TerrainSnapshot *evidence,\n    42\t                                               double tolerance_m, double step_m,\n    43\t                                               double guard_radius_m,\n    44\t                                               EvidenceFloorFill *summary = nullptr) {\n    45\t  TerrainSnapshot out = navigation;\n    46\t  EvidenceFloorFill fill;\n    47\t  const bool usable = evidence != nullptr && valid(navigation) && valid(*evidence) &&\n    48\t      evidence->frame == navigation.frame &&\n    49\t      std::abs(evidence->resolution_m - navigation.resolution_m) <= 1e-9 &&\n    50\t      std::isfinite(tolerance_m) && tolerance_m >= 0.0 &&\n    51\t      std::isfinite(step_m) && step_m > 0.0 &&\n    52\t      std::isfinite(guard_radius_m) && guard_radius_m >= 0.0;\n    53\t  if (!usable) {\n    54\t    if (summary) *summary = fill;\n    55\t    return out;\n    56\t  }\n    57\t  fill.evidence_used = true;\n    58\t  const double resolution = navigation.resolution_m;\n    59\t  // Evidence cells whose squares come within guard_radius_m of the candidate cell's square.\n    60\t  std::vector<Cell2> guard;\n    61\t  const int reach = static_cast<int>(std::ceil(guard_radius_m / resolution)) + 1;\n    62\t  for (int dx = -reach; dx <= reach; ++dx)\n    63\t    for (int dy = -reach; dy <= reach; ++dy) {\n    64\t      const double gap_x = std::max(0, std::abs(dx) - 1) * resolution;\n    65\t      const double gap_y = std::max(0, std::abs(dy) - 1) * resolution;\n    66\t      if (gap_x * gap_x + gap_y * gap_y <= guard_radius_m * guard_radius_m + 1e-12)\n    67\t        guard.push_back({dx, dy});\n    68\t    }\n    69\t  // A drop: no surface within step_m of the level, and no surface at all or one below it.\n    70\t  const auto drop = [&](const Cell2 &cell, double level) {\n    71\t    const auto found = evidence->cells.find(cell);\n    72\t    if (found == evidence->cells.end()) return true;\n    73\t    bool lower = false;\n    74\t    for (const SurfaceCell &surface : found->second) {\n    75\t      if (std::abs(surface.elevation_m - level) <= step_m) return false;\n    76\t      if (surface.elevation_m < level - step_m) lower = true;\n    77\t    }\n    78\t    return lower;\n    79\t  };\n    80\t  for (const auto &entry : evidence->cells) {\n    81\t    int ix = 0, iy = 0;\n    82\t    if (!evidenceFillIndex(evidence->origin_x_m + (entry.first.x + 0.5) * resolution,\n    83\t                           navigation.origin_x_m, resolution, ix) ||\n    84\t        !evidenceFillIndex(evidence->origin_y_m + (entry.first.y + 0.5) * resolution,\n    85\t                           navigation.origin_y_m, resolution, iy)) continue;\n    86\t    const Cell2 target{ix, iy};\n    87\t    for (const SurfaceCell &candidate : entry.second) {\n    88\t      const double level = candidate.elevation_m;\n    89\t      const auto present = out.cells.find(target);\n    90\t      if (present != out.cells.end() &&\n    91\t          std::any_of(present->second.begin(), present->second.end(), [&](const SurfaceCell &surface) {\n    92\t            return std::abs(surface.elevation_m - level) <= tolerance_m;\n    93\t          })) continue;\n    94\t      bool rejected = false;\n    95\t      for (const Cell2 &offset : guard)\n    96\t        if (drop({entry.first.x + offset.x, entry.first.y + offset.y}, level)) {\n    97\t          rejected = true;\n    98\t          break;\n    99\t        }\n   100\t      if (rejected) {\n   101\t        ++fill.drop_rejected;\n   102\t        continue;\n   103\t      }\n   104\t      // The decoder's default status; the step score labels it with the other layers.\n   105\t      out.cells[target].push_back({Support::Stair, level});\n   106\t      ++fill.added;\n   107\t    }\n   108\t  }\n   109\t  if (summary) *summary = fill;\n   110\t  return out;\n   111\t}\n   112\t\n   113\t}  // namespace reactive_stair\n   114\t\n   115\t#endif\n     1\t// Included only by scan_06 grid_map.cpp after GridMap is defined.\n     2\t// PCT selected ground cells are a static support map, not live obstacle truth.\n     3\t// The LiDAR raycasting path remains unchanged; only the common collision query\n     4\t// uses positively classified measured LiDAR endpoints to waive terrain hits.\n     5\t#include <cstdint>\n     6\t#include <limits>\n     7\t#include <pcl/point_types.h>\n     8\t#include <plan_env/raw_return_classification.h>\n     9\t#include <plan_env/known_lite3_trunk.h>\n    10\t#include <plan_env/motion_heading.h>\n    11\t\n    12\treactive_stair::TerrainSnapshot GridMap::decodeReactiveGround(sensor_msgs::msg::PointCloud2::ConstSharedPtr msg) const {\n    13\t  reactive_stair::TerrainSnapshot terrain;\n    14\t  terrain.frame = msg->header.frame_id;\n    15\t  terrain.stamp_s = rclcpp::Time(msg->header.stamp).seconds();\n    16\t  terrain.resolution_m = reactive_tomogram_resolution_m_;\n    17\t  if (terrain.frame != mp_.frame_id_ || !std::isfinite(terrain.stamp_s) ||\n    18\t      terrain.stamp_s <= 0.0 || !std::isfinite(terrain.resolution_m) ||\n    19\t      terrain.resolution_m <= 0.0 || !std::isfinite(reactive_tomogram_z_offset_m_) ||\n    20\t      !std::isfinite(reactive_cost_limit_) || reactive_cost_limit_ < 0.0 ||\n    21\t      !std::isfinite(reactive_terrain_band_m_) || reactive_terrain_band_m_ < 0.0) {\n    22\t    return {};\n    23\t  }\n    24\t  // Exact existing publisher layout; reject malformed metadata before PCL.\n    25\t  if (msg->height != 1 || msg->width == 0 || msg->is_bigendian ||\n    26\t      msg->point_step != 16 || msg->fields.size() != 4 ||\n    27\t      uint64_t(msg->width) * 16 != msg->row_step ||\n    28\t      uint64_t(msg->row_step) != msg->data.size()) return {};\n    29\t  uint32_t expected_offset = 0;\n    30\t  for (const char *field_name : {\"x\", \"y\", \"z\", \"intensity\"}) {\n    31\t    bool found = false;\n    32\t    for (const auto &field : msg->fields)\n    33\t      if (field.name == field_name && field.datatype == sensor_msgs::msg::PointField::FLOAT32 &&\n    34\t          field.count == 1 && field.offset == expected_offset) found = true;\n    35\t    if (!found) {\n    36\t      return {};\n    37\t    }\n    38\t    expected_offset += 4;\n    39\t  }\n    40\t  pcl::PointCloud<pcl::PointXYZI> points;\n    41\t  pcl::fromROSMsg(*msg, points);\n    42\t  double min_x = std::numeric_limits<double>::infinity();\n    43\t  double min_y = std::numeric_limits<double>::infinity();\n    44\t  for (const auto &point : points.points) {\n    45\t    if (!std::isfinite(point.x) || !std::isfinite(point.y) || !std::isfinite(point.z) ||\n    46\t        !std::isfinite(point.intensity) || point.intensity > reactive_cost_limit_) continue;\n    47\t    min_x = std::min(min_x, static_cast<double>(point.x));\n    48\t    min_y = std::min(min_y, static_cast<double>(point.y));\n    49\t  }\n    50\t  if (!std::isfinite(min_x) || !std::isfinite(min_y)) {\n    51\t    return {};\n    52\t  }\n    53\t  terrain.origin_x_m = min_x - terrain.resolution_m / 2.0;\n    54\t  terrain.origin_y_m = min_y - terrain.resolution_m / 2.0;\n    55\t  // A lightweight content identity ties this static version to the exact\n    56\t  // delivered bytes. It is not a cryptographic source-file provenance hash.\n    57\t  uint64_t fingerprint = UINT64_C(14695981039346656037);\n    58\t  for (uint8_t value : msg->data) {\n    59\t    fingerprint ^= value;\n    60\t    fingerprint *= UINT64_C(1099511628211);\n    61\t  }\n    62\t  terrain.source_id = \"pct_tomogram/fnv64/\" + std::to_string(fingerprint);\n    63\t  for (const auto &point : points.points) {\n    64\t    if (!std::isfinite(point.x) || !std::isfinite(point.y) || !std::isfinite(point.z) ||\n    65\t        !std::isfinite(point.intensity) || point.intensity > reactive_cost_limit_) continue;\n    66\t    const double ix = std::floor((point.x - terrain.origin_x_m) / terrain.resolution_m);\n    67\t    const double iy = std::floor((point.y - terrain.origin_y_m) / terrain.resolution_m);\n    68\t    if (ix < std::numeric_limits<int>::min() || ix > std::numeric_limits<int>::max() ||\n    69\t        iy < std::numeric_limits<int>::min() || iy > std::numeric_limits<int>::max()) continue;\n    70\t    // \"Stair\" here means a selected supported PCT cell; the topic carries no\n    71\t    // flat-vs-stair semantic label. Multiple heights at one XY are retained.\n    72\t    terrain.cells[{static_cast<int>(ix), static_cast<int>(iy)}].push_back(\n    73\t        {reactive_stair::Support::Stair, point.z - reactive_tomogram_z_offset_m_});\n    74\t  }\n    75\t  return terrain;\n    76\t}\n    77\t\n    78\treactive_stair::TerrainSnapshot GridMap::supportGround(const reactive_stair::TerrainSnapshot &navigation) {\n    79\t  // v34: PCT's navigation ground is inflated; the surface evidence is its\n    80\t  // uninflated selection. Add the evidence floor that the navigation ground lacks,\n    81\t  // except beside drops (audits/2026-09-29_corridor_entry, versions/v34/PLAN.md).\n    82\t  reactive_stair::EvidenceFloorFill fill;\n    83\t  auto ground = reactive_stair::addGuardedEvidenceFloor(navigation, &reactive_surface_ground_,\n    84\t      reactive_parameters_.body_height_tolerance_m, reactive_stair::StepScoreParameters{}.critical_height_m,\n    85\t      mp_.double_cylinder_radius_, &fill);\n    86\t  size_t layers = 0;\n    87\t  for (const auto &entry : navigation.cells) layers += entry.second.size();\n    88\t  RCLCPP_INFO(node_->get_logger(),\n    89\t      \"evidence_floor_fill evidence_used=%d navigation_layers=%zu added=%zu drop_rejected=%zu\",\n    90\t      fill.evidence_used ? 1 : 0, layers, fill.added, fill.drop_rejected);\n    91\t  return ground;\n    92\t}\n    93\t\n    94\tvoid GridMap::reactiveTomogramCallback(sensor_msgs::msg::PointCloud2::ConstSharedPtr msg) {\n    95\t  reactive_ground_ = reactive_stair::TerrainSnapshot{};\n    96\t  reactive_cloud_ready_ = false;\n    97\t  reactive_pending_cloud_ = false;\n    98\t  reactive_terrain_hits_.clear();\n    99\t  auto terrain = decodeReactiveGround(msg);\n   100\t  // v34: keep the navigation ground as decoded, and give SCAN's copy the guarded\n   101\t  // evidence floor. An invalid ground passes unchanged.\n   102\t  reactive_navigation_ground_ = terrain;\n   103\t  terrain = supportGround(terrain);\n   104\t  if (terrain.cells.empty()) {\n   105\t    reactive_decision_.acceptTerrain(terrain);\n   106\t    return;\n   107\t  }\n   108\t  // The surface evidence decides whether a neighbour without this level is a drop.\n   109\t  reactive_stair::StepScoreResult scored =\n   110\t      reactive_stair::precomputeEthStyleStepScores(terrain, {}, &reactive_surface_ground_);\n   111\t  if (reactive_decision_.acceptTerrain(scored.support)) {\n   112\t    reactive_ground_ = terrain; // Preserve source elevations independently of step scores.\n   113\t    reactive_terrain_ = scored.support;\n   114\t    reactive_step_result_ = std::move(scored);\n   115\t  }\n   116\t}\n   117\t\n   118\tvoid GridMap::reactiveSurfaceGroundCallback(sensor_msgs::msg::PointCloud2::ConstSharedPtr msg) {\n   119\t  reactive_surface_ground_ = decodeReactiveGround(msg);\n   120\t  // A changed source must not retain positive labels from an older source.\n   121\t  // Historical nonterrain evidence remains conservative and is not cleared.\n   122\t  reactive_terrain_hits_.clear();\n   123\t  reactive_cloud_ready_ = false;\n   124\t  reactive_pending_cloud_ = false;\n   125\t  // The step score consults this evidence, so rescore the accepted navigation\n   126\t  // ground. Unusable evidence scores exactly as without evidence.\n   127\t  // v34: re-augment the navigation ground as decoded with this evidence, so the\n   128\t  // result does not depend on which message arrived first.\n   129\t  if (!reactive_ground_.cells.empty()) reactive_ground_ = supportGround(reactive_navigation_ground_);\n   130\t  if (!reactive_ground_.cells.empty()) {\n   131\t    reactive_stair::StepScoreResult scored = reactive_stair::precomputeEthStyleStepScores(\n   132\t        reactive_ground_, {}, &reactive_surface_ground_);\n   133\t    if (reactive_decision_.acceptTerrain(scored.support)) {\n   134\t      reactive_terrain_ = scored.support;\n   135\t      reactive_step_result_ = std::move(scored);\n   136\t    }\n   137\t  }\n   138\t}\n   139\t\n   140\tbool GridMap::reactiveSurfaceGroundReady() const {\n   141\t  if (reactive_surface_ground_topic_.empty()) return true;\n   142\t  const double now = node_->now().seconds();\n   143\t  const auto fresh = [&](const reactive_stair::TerrainSnapshot &surface) {\n   144\t    return !surface.cells.empty() && surface.frame == mp_.frame_id_ &&\n   145\t        std::isfinite(surface.stamp_s) && surface.stamp_s > 0.0 &&\n   146\t        surface.stamp_s <= now && now - surface.stamp_s <= reactive_parameters_.terrain_max_age_s;\n   147\t  };\n   148\t  return fresh(reactive_ground_) && fresh(reactive_surface_ground_);\n   149\t}\n   150\t\n   151\tbool GridMap::reactiveTerrainReturn(const Eigen::Vector3d &point) const {\n   152\t  if (!reactiveSurfaceGroundReady()) return false;\n   153\t  // A configured source replaces the classification evidence, not navigation support.\n   154\t  const auto &evidence = reactive_surface_ground_topic_.empty()\n   155\t      ? reactive_ground_ : reactive_surface_ground_;\n   156\t  return reactive_stair::selectedGroundReturn(evidence,\n   157\t      point.x(), point.y(), point.z(), reactive_terrain_band_m_);\n   158\t}\n   159\t\n   160\tbool GridMap::reactiveFootprintSupportQuery(const Eigen::Vector3d &body_reference,\n   161\t    const reactive_stair::NonTerrainVoxel &obstacle, reactive_stair::Query &query) {\n   162\t  if (!body_reference.allFinite()) return false;\n   163\t  const auto &raw = reactive_ground_;\n   164\t  const auto &scored = reactive_terrain_;\n   165\t  if (raw.source_id != scored.source_id || raw.frame != scored.frame ||\n   166\t      raw.resolution_m != scored.resolution_m || raw.origin_x_m != scored.origin_x_m ||\n   167\t      raw.origin_y_m != scored.origin_y_m) return false;\n   168\t  auto body_query = query;\n   169\t  body_query.x_m = body_reference.x();\n   170\t  body_query.y_m = body_reference.y();\n   171\t  body_query.z_m = body_reference.z();\n   172\t  body_query.in_map = isInMap(body_reference);\n   173\t  // This copy checks terrain support only. The original measured obstacle\n   174\t  // still controls the final footprint verdict at the original physical XYZ.\n   175\t  auto support_only = obstacle;\n   176\t  support_only.occupancy = reactive_stair::Occupancy::Free;\n   177\t  if (reactive_decision_.decide(body_query, support_only) != reactive_stair::Verdict::Free)\n   178\t    return false;\n   179\t  const auto associated_height = [&](double x, double y, double target, double limit, double &height) {\n   180\t    const double ix = std::floor((x - raw.origin_x_m) / raw.resolution_m);\n   181\t    const double iy = std::floor((y - raw.origin_y_m) / raw.resolution_m);\n   182\t    if (!std::isfinite(ix) || !std::isfinite(iy) ||\n   183\t        ix < std::numeric_limits<int>::min() || ix > std::numeric_limits<int>::max() ||\n   184\t        iy < std::numeric_limits<int>::min() || iy > std::numeric_limits<int>::max()) return false;\n   185\t    const reactive_stair::Cell2 cell{static_cast<int>(ix), static_cast<int>(iy)};\n   186\t    const auto original = raw.cells.find(cell), classified = scored.cells.find(cell);\n   187\t    if (original == raw.cells.end() || classified == scored.cells.end() ||\n   188\t        original->second.size() != classified->second.size()) return false;\n   189\t    // Associate before considering scored status. Never skip an unknown or\n   190\t    // unsupported nearest layer in favor of a farther supported floor.\n   191\t    const int layer = reactive_stair::nearestSurface(original->second, target, limit);\n   192\t    if (layer < 0) return false;\n   193\t    const auto &surface = classified->second[layer];\n   194\t    if (surface.elevation_m != original->second[layer].elevation_m ||\n   195\t        !reactive_stair::selectedSurface(surface)) return false;\n   196\t    height = surface.elevation_m;\n   197\t    return true;\n   198\t  };\n   199\t  double body_ground, footprint_ground;\n   200\t  const double step = reactive_stair::StepScoreParameters{}.critical_height_m;\n   201\t  if (!associated_height(body_query.x_m, body_query.y_m,\n   202\t          body_query.z_m - reactive_parameters_.body_clearance_m,\n   203\t          reactive_parameters_.body_height_tolerance_m, body_ground) ||\n   204\t      !associated_height(query.x_m, query.y_m, body_ground, step, footprint_ground) ||\n   205\t      std::abs(footprint_ground - body_ground) >= step) return false;\n   206\t  // Only the support-layer height changes; do not move the robot, spline,\n   207\t  // obstacle query, map-boundary query or retained measured LiDAR evidence.\n   208\t  query.z_m = footprint_ground + reactive_parameters_.body_clearance_m;\n   209\t  return true;\n   210\t}\n   211\t\n   212\tint GridMap::reactiveOccupancy(const Eigen::Vector3d &point, const Eigen::Vector3d *body_reference) {\n   213\t  if (!reactiveSurfaceGroundReady()) return 1;\n   214\t  if (!point.allFinite()) return 1;\n   215\t  const double radius = mp_.double_cylinder_radius_;\n   216\t  if (!std::isfinite(radius) || radius < 0.0 ||\n   217\t      point.x() - radius < mp_.map_min_boundary_.x() ||\n   218\t      point.x() + radius > mp_.map_max_boundary_.x() ||\n   219\t      point.y() - radius < mp_.map_min_boundary_.y() ||\n   220\t      point.y() + radius > mp_.map_max_boundary_.y() ||\n   221\t      point.z() - mp_.obstacles_inflation_z_down < mp_.map_min_boundary_.z() ||\n   222\t      point.z() + mp_.obstacles_inflation_z_up > mp_.map_max_boundary_.z()) return 1;\n   223\t  reactive_stair::Query query;\n   224\t  query.frame = mp_.frame_id_;\n   225\t  query.stamp_s = node_->now().seconds();\n   226\t  query.x_m = point.x(); query.y_m = point.y(); query.z_m = point.z();\n   227\t  query.in_map = isInMap(point);\n   228\t  reactive_stair::NonTerrainVoxel obstacle;\n   229\t  obstacle.frame = mp_.frame_id_;\n   230\t  obstacle.stamp_s = reactive_cloud_stamp_s_;\n   231\t  if (reactive_cloud_ready_) obstacle.source_id = \"scan_lidar_cloud\";\n   232\t  if (query.in_map) {\n   233\t    Eigen::Vector3i query_id;\n   234\t    posToIndex(point, query_id);\n   235\t    const int address = toAddress(query_id);\n   236\t    if (md_.occupancy_buffer_[address] < mp_.clamp_min_log_ - 1e-3) {\n   237\t      obstacle.occupancy = reactive_stair::Occupancy::Unknown;\n   238\t    } else if (md_.occupancy_buffer_inflate_[address] == 0) {\n   239\t      obstacle.occupancy = reactive_stair::Occupancy::Free;\n   240\t    } else {\n   241\t      // Every raw occupied source contributing to SCAN's inflated hit must\n   242\t      // have a retained, positively observed terrain classification. One unclassified\n   243\t      // return, even at a supported XY, keeps the result occupied.\n   244\t      bool contributor = false;\n   245\t      bool unclassified = false;\n   246\t      for (const auto &offset : md_.inflate_offsets_) {\n   247\t        const Eigen::Vector3i source = query_id - offset;\n   248\t        if (!isInMap(source) || md_.occupancy_buffer_[toAddress(source)] <= mp_.min_occupancy_log_)\n   249\t          continue;\n   250\t        contributor = true;\n   251\t        const auto key = std::make_tuple(source.x(), source.y(), source.z());\n   252\t        if (!reactive_stair::mayWaiveRawContributor(\n   253\t                reactive_terrain_hits_.count(key) != 0,\n   254\t                reactive_nonterrain_hits_.count(key) != 0,\n   255\t                reactive_nonterrain_history_.count(key) != 0)) {\n   256\t          unclassified = true;\n   257\t          break;\n   258\t        }\n   259\t      }\n   260\t      obstacle.occupancy = !contributor ? reactive_stair::Occupancy::Unknown :\n   261\t          (unclassified ? reactive_stair::Occupancy::Occupied : reactive_stair::Occupancy::Free);\n   262\t    }\n   263\t  }\n   264\t  if (reactive_known_trunk_enabled_ && query.in_map && reactive_body_stamp_s_ > 0.0) {\n   265\t    Eigen::Vector3i id;\n   266\t    posToIndex(point, id);\n   267\t    // Test the queried point, not its voxel centre, so the waiver does not\n   268\t    // depend on how the grid aligns with the body height.\n   269\t    const Eigen::Vector3d local = reactive_body_quaternion_.conjugate() *\n   270\t                                 (point - md_.sliding_map_frame_pos_);\n   271\t    const bool inside = reactive_stair::knownNavigationFootprintInterior(\n   272\t        local.x(), local.y(), local.z(), query.stamp_s, reactive_body_stamp_s_,\n   273\t        mp_.double_cylinder_radius_, mp_.double_cylinder_offset_);\n   274\t    obstacle.occupancy = reactive_stair::measuredTrunkQuery(\n   275\t        obstacle.occupancy, md_.occupancy_buffer_inflate_[toAddress(id)] != 0, inside);\n   276\t  }\n   277\t  if (body_reference && !reactiveFootprintSupportQuery(*body_reference, obstacle, query)) return 1;\n   278\t  const auto verdict = reactive_decision_.decide(query, obstacle);\n   279\t  static std::set<std::tuple<int, int, int>> diagnosed;\n   280\t  Eigen::Vector3i diagnostic_id;\n   281\t  posToIndex(point, diagnostic_id);\n   282\t  const auto diagnostic_key = std::make_tuple(diagnostic_id.x(), diagnostic_id.y(), diagnostic_id.z());\n   283\t  if (query.in_map && (reactive_diagnostic_force_ || ((point - md_.ray_pos_).norm() < 0.8 &&\n   284\t      diagnosed.size() < 120 && diagnosed.insert(diagnostic_key).second))) {\n   285\t    const int diagnostic_address = toAddress(diagnostic_id);\n   286\t    RCLCPP_WARN(node_->get_logger(),\n   287\t        \"near_sensor_verdict verdict=%d voxel=%d q=(%.5f,%.5f,%.5f) sensor=(%.5f,%.5f,%.5f) log_odds=%.5f inflation=%d stamp=%.3f\",\n   288\t        static_cast<int>(verdict), static_cast<int>(obstacle.occupancy),\n   289\t        point.x(), point.y(), point.z(), md_.ray_pos_.x(), md_.ray_pos_.y(), md_.ray_pos_.z(),\n   290\t        md_.occupancy_buffer_[diagnostic_address], static_cast<int>(md_.occupancy_buffer_inflate_[diagnostic_address]), query.stamp_s);\n   291\t  }\n   292\t  if (verdict != reactive_stair::Verdict::Free) {\n   293\t    RCLCPP_WARN_THROTTLE(node_->get_logger(), *node_->get_clock(), 1000,\n   294\t        \"reactive_collision_blocked verdict=%d voxel=%d q=(%.3f,%.3f,%.3f) support_z=%.3f now=%.3f cloud_stamp=%.3f cloud_ready=%d terrain_cells=%zu body_clearance=%.3f\",\n   295\t        static_cast<int>(verdict), static_cast<int>(obstacle.occupancy),\n   296\t        point.x(), point.y(), point.z(), query.z_m, query.stamp_s, obstacle.stamp_s,\n   297\t        reactive_cloud_ready_, reactive_terrain_.cells.size(), reactive_parameters_.body_clearance_m);\n   298\t  }\n   299\t  return verdict == reactive_stair::Verdict::Free ? 0 : 1;\n   300\t}\n   301\t\n   302\tvoid GridMap::logInitialSplineCollision(const Eigen::Vector3d &pos, double yaw) {\n   303\t  RCLCPP_WARN(node_->get_logger(),\n   304\t      \"initial_spline_collision pos=(%.8f,%.8f,%.8f) yaw=%.8f body=(%.8f,%.8f,%.8f) body_q=(%.8f,%.8f,%.8f,%.8f) body_stamp=%.8f now=%.8f\",\n   305\t      pos.x(), pos.y(), pos.z(), yaw,\n   306\t      md_.sliding_map_frame_pos_.x(), md_.sliding_map_frame_pos_.y(), md_.sliding_map_frame_pos_.z(),\n   307\t      reactive_body_quaternion_.w(), reactive_body_quaternion_.x(), reactive_body_quaternion_.y(), reactive_body_quaternion_.z(),\n   308\t      reactive_body_stamp_s_, node_->now().seconds());\n   309\t  const Eigen::Vector3d heading(std::cos(yaw), std::sin(yaw), 0.0);\n   310\t  reactive_diagnostic_force_ = true;\n","exit_code":0,"status":"completed"}}
