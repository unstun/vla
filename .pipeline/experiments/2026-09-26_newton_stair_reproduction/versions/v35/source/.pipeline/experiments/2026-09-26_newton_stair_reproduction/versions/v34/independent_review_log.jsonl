e->resolution_m);\n115:  const auto found = evidence->cells.find({static_cast<int>(ix), static_cast<int>(iy)});\n116:  if (found == evidence->cells.end()) return false;\n124:    const TerrainSnapshot &input, const StepScoreParameters &parameters = {},\n125:    const TerrainSnapshot *evidence = nullptr) {\n128:  const bool parameters_valid = valid(input) &&\n131:      std::isfinite(parameters.critical_height_m) && parameters.critical_height_m > 0.0 &&\n138:      for (auto &surface : entry.second) surface.support = Support::Unknown;\n141:  // Unusable evidence scores exactly as without evidence.\n142:  const TerrainSnapshot *usable_evidence =\n143:      evidence && valid(*evidence) && evidence->frame == input.frame &&\n144:      std::abs(evidence->resolution_m - input.resolution_m) <= 1e-9 ? evidence : nullptr;\n148:  // an unambiguous nearby surface; do not join different building floors.\n149:  // Without one, the neighbour is a possible drop unless the surface evidence\n150:  // shows ground at this level there; that evidence height then counts.\n155:      const auto &surface = entry.second[layer];\n156:      if (!selectedSurface(surface)) continue;\n164:        const int nearest = nearestSurface(cell->second, surface.elevation_m, parameters.critical_height_m);\n168:        } else if (!evidenceSurfaceHeight(usable_evidence, input, neighbor, surface.elevation_m,\n169:                                          parameters.critical_height_m, height)) {\n188:      auto &surface = entry.second[layer];\n192:        surface.support = Support::Unknown;\n202:        const int nearest = nearestSurface(cell->second, original[layer].elevation_m, parameters.critical_height_m);\n204:          // Measured evidence ground has no score; ETH skips missing scores.\n205:          double evidence_height = 0.0;\n206:          if (evidenceSurfaceHeight(usable_evidence, input, neighbor, original[layer].elevation_m,\n207:                                    parameters.critical_height_m, evidence_height)) continue;\n214:        if (neighbor_score.first_pass_height_m > parameters.critical_height_m)\n218:        surface.support = Support::Unknown;\n224:                                      parameters.critical_height_m,\n226:      if (score.first_pass_height_m >= parameters.critical_height_m || score.score <= 0.0)\n227:        surface.support = Support::Unsupported;\n229:        surface.support = Support::Stair;\n231:        surface.support = Support::Flat;\n","exit_code":0,"status":"completed"}}
