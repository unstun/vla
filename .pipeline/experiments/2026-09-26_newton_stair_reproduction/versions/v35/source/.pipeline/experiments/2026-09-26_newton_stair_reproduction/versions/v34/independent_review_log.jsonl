{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc 'nl -ba .pipeline/experiments/2026-09-26_newton_stair_reproduction/versions/v34/fill_contract/oracle.py\nnl -ba .pipeline/experiments/2026-09-26_newton_stair_reproduction/versions/v34/fill_contract/check.py'","aggregated_output":"     1\t\"\"\"Independent Python implementation of v34's rule (PLAN.md, \"The rule\"), for the fill contract's checker.\n     2\t\n     3\tWritten from PLAN.md's text, not from the C++ header:\n     4\t- decode: as GridMap::decodeReactiveGround with the planner defaults (0.1 m cells, z - 0.03 m, finite records with\n     5\t  cost <= 20; origin = minimum kept x and y - 0.05 m; layers in file order).\n     6\t- a snapshot is usable evidence when it is valid (source, frame, finite stamp, positive resolution, finite origin,\n     7\t  non-empty cells, every cell non-empty, every elevation finite), in the navigation's frame and at its resolution.\n     8\t- for every evidence cell in (x, y) order and each of its layers in order: the target is the navigation cell that\n     9\t  contains the evidence cell's centre. Skip when the target (with layers added earlier) has a layer within 0.12 m.\n    10\t  Otherwise reject when any evidence cell whose square comes within 0.35 m of the candidate's square is a drop: it is\n    11\t  absent, or it has no layer within 0.26 m of the level and some layer below level - 0.26 m. Else add.\n    12\t\"\"\"\n    13\timport math\n    14\tfrom pathlib import Path\n    15\t\n    16\timport numpy as np\n    17\t\n    18\tTOLERANCE, STEP, GUARD = 0.12, 0.26, 0.35\n    19\t\n    20\t\n    21\tclass Snapshot:\n    22\t    def __init__(self, cells, origin=(0.0, 0.0), resolution=0.1, frame=\"world\"):\n    23\t        self.cells = {k: list(v) for k, v in cells.items()}\n    24\t        self.origin = origin\n    25\t        self.resolution = resolution\n    26\t        self.frame = frame\n    27\t\n    28\t    def valid(self):\n    29\t        return (math.isfinite(self.resolution) and self.resolution > 0 and all(map(math.isfinite, self.origin))\n    30\t                and bool(self.cells) and all(v and all(math.isfinite(z) for z in v) for v in self.cells.values()))\n    31\t\n    32\t\n    33\tdef decode_f32(path):\n    34\t    a = np.fromfile(Path(path), dtype=\"<f4\").reshape(-1, 4)\n    35\t    keep = np.isfinite(a).all(1) & (a[:, 3] <= 20.0)\n    36\t    kept = a[keep]\n    37\t    origin = (float(kept[:, 0].min()) - 0.05, float(kept[:, 1].min()) - 0.05)\n    38\t    cells = {}\n    39\t    for x, y, z, _ in kept:\n    40\t        cells.setdefault((math.floor((float(x) - origin[0]) / 0.1), math.floor((float(y) - origin[1]) / 0.1)),\n    41\t                         []).append(float(z) - 0.03)\n    42\t    return Snapshot(cells, origin)\n    43\t\n    44\t\n    45\tdef guard_offsets(resolution):\n    46\t    reach = math.ceil(GUARD / resolution) + 1\n    47\t    out = []\n    48\t    for dx in range(-reach, reach + 1):\n    49\t        for dy in range(-reach, reach + 1):\n    50\t            gx, gy = max(0, abs(dx) - 1) * resolution, max(0, abs(dy) - 1) * resolution\n    51\t            if gx * gx + gy * gy <= GUARD * GUARD + 1e-12:\n    52\t                out.append((dx, dy))\n    53\t    return out\n    54\t\n    55\t\n    56\tdef fill(navigation, evidence):\n    57\t    \"\"\"Return (augmented cells, added list [(cell, z)], rejected count, evidence_used).\"\"\"\n    58\t    out = {k: list(v) for k, v in navigation.cells.items()}\n    59\t    usable = (evidence is not None and navigation.valid() and evidence.valid() and evidence.frame == navigation.frame\n    60\t              and abs(evidence.resolution - navigation.resolution) <= 1e-9)\n    61\t    if not usable:\n    62\t        return out, [], 0, False\n    63\t    res = navigation.resolution\n    64\t    offsets = guard_offsets(res)\n    65\t\n    66\t    def drop(cell, level):\n    67\t        layers = evidence.cells.get(cell)\n    68\t        if layers is None:\n    69\t            return True\n    70\t        if any(abs(z - level) <= STEP for z in layers):\n    71\t            return False\n    72\t        return any(z < level - STEP for z in layers)\n    73\t\n    74\t    added, rejected = [], 0\n    75\t    for (ex, ey) in sorted(evidence.cells):\n    76\t        cx = evidence.origin[0] + (ex + 0.5) * res\n    77\t        cy = evidence.origin[1] + (ey + 0.5) * res\n    78\t        target = (math.floor((cx - navigation.origin[0]) / res), math.floor((cy - navigation.origin[1]) / res))\n    79\t        for level in evidence.cells[(ex, ey)]:\n    80\t            if any(abs(z - level) <= TOLERANCE for z in out.get(target, [])):\n    81\t                continue\n    82\t            if any(drop((ex + dx, ey + dy), level) for dx, dy in offsets):\n    83\t                rejected += 1\n    84\t                continue\n    85\t            out.setdefault(target, []).append(level)\n    86\t            added.append((target, level))\n    87\t    return out, added, rejected, True\n     1\t\"\"\"Judge the red/green fill contract (versions/v34/PLAN.md, K2); writes contract_results.json.\n     2\t\n     3\t- Cases: every output layer of both builds is compared with its expectation, layer by layer in order: red must return\n     4\t  the navigation input unchanged; green must equal oracle.py. Each case's designed outcome (make_cases.EXPECTATION)\n     5\t  is asserted on the oracle's output as well, so a wrong oracle cannot pass a wrong native result.\n     6\t- Real map: green's added layers on the pinned grounds must equal the oracle's exactly (cell and float64 height),\n     7\t  with every navigation layer kept; red must add nothing.\n     8\t- Node: every checkpoint of both orders must show the node's raw ground, scored terrain and decision terrain equal\n     9\t  to the tree's own headers on the node's decoded inputs, and green's kept navigation ground equal to the decoded\n    10\t  navigation ground. Green must have added layers after valid evidence and fewer with the entry hole; red none.\n    11\t\"\"\"\n    12\tfrom pathlib import Path\n    13\timport csv, json, math, sys\n    14\t\n    15\tHERE = Path(__file__).resolve().parent\n    16\tBASE = HERE.parents[2]\n    17\tsys.path.insert(0, str(HERE))\n    18\timport oracle  # noqa: E402\n    19\timport make_cases  # noqa: E402\n    20\t\n    21\tLABELS = {\"red_v33\": False, \"green_v34\": True}\n    22\tFLOOR, HOLE = make_cases.FLOOR, (15, 6)\n    23\t\n    24\t\n    25\tdef snapshot(cells_list, origin=(0.0, 0.0), resolution=0.1, frame=\"world\"):\n    26\t    cells = {}\n    27\t    for x, y, z in cells_list:\n    28\t        cells.setdefault((x, y), []).append(z)\n    29\t    return oracle.Snapshot(cells, origin, resolution, frame)\n    30\t\n    31\t\n    32\tdef case_inputs(mode, origin, nav, evidence):\n    33\t    navigation = snapshot(nav)\n    34\t    if mode == \"none\":\n    35\t        return navigation, None\n    36\t    e = snapshot(evidence, origin, 0.2 if mode == \"resolution_0.2\" else 0.1, \"map\" if mode == \"frame_map\" else \"world\")\n    37\t    if mode == \"empty\":\n    38\t        e.cells = {}\n    39\t    if mode == \"nan\":\n    40\t        e.cells.setdefault((0, 0), []).append(math.nan)\n    41\t    return navigation, e\n    42\t\n    43\t\n    44\tdef near_hole(x, y):\n    45\t    gx, gy = max(0, abs(x - HOLE[0]) - 1) * 0.1, max(0, abs(y - HOLE[1]) - 1) * 0.1\n    46\t    return gx * gx + gy * gy <= 0.35 * 0.35 + 1e-12\n    47\t\n    48\t\n    49\tdef designed(name, navigation, out, added):\n    50\t    \"\"\"The case's designed outcome, judged on an output (the oracle's or the native one).\"\"\"\n    51\t    trimmed = {(x, y) for x in range(6, 21) for y in range(13)}\n    52\t    at_floor = {c for c, z in added if abs(z - FLOOR) < 1e-9}\n    53\t    kind = make_cases.EXPECTATION[name]\n    54\t    if kind == \"adds\":\n    55\t        return at_floor == trimmed and len(added) == len(trimmed)\n    56\t    if kind == \"adds_at_6_6_keeps_wrong\":\n    57\t        return added == [((6, 6), FLOOR)] and out[(6, 6)][0] == 1.42\n    58\t    if kind == \"rejects_near_hole\":\n    59\t        return at_floor == {c for c in trimmed if not near_hole(*c)} - {HOLE}\n    60\t    if kind == \"adds_all_trimmed\":\n    61\t        return at_floor == trimmed - {HOLE}\n    62\t    if kind == \"adds_none_at_floor\":\n    63\t        return not at_floor\n    64\t    if kind == \"adds_beside\":\n    65\t        return at_floor == trimmed and all(abs(out[c][0] - (FLOOR - 0.13)) < 1e-9 for c in trimmed)\n    66\t    if kind == \"adds_once\":\n    67\t        return at_floor == trimmed and len(added) == len(trimmed)\n    68\t    if kind == \"adds_shifted\":\n    69\t        return bool(added) and all(c[0] <= 19 and c[1] <= 11 for c, _ in added) and any(c[0] == -1 for c, _ in added)\n    70\t    if kind == \"unchanged\":\n    71\t        return not added and out == navigation.cells\n    72\t    raise KeyError(kind)\n    73\t\n    74\t\n    75\tdef read_case_layers(path):\n    76\t    layers = {}\n    77\t    for r in csv.DictReader(path.open()):\n    78\t        layers.setdefault(r[\"case\"], {}).setdefault((int(r[\"ix\"]), int(r[\"iy\"])), []).append(float(r[\"elevation\"]))\n    79\t    return layers\n    80\t\n    81\t\n    82\tresults = {\"cases\": {}, \"map\": {}, \"node\": {}}\n    83\toracle_cases = {}\n    84\tfor name, spec in make_cases.CASES.items():\n    85\t    navigation, evidence = case_inputs(*spec)\n    86\t    out, added, rejected, used = oracle.fill(navigation, evidence)\n    87\t    oracle_cases[name] = {\"navigation\": navigation, \"out\": out, \"added\": added, \"used\": used,\n    88\t                          \"designed\": designed(name, navigation, out, added)}\n    89\tnav = oracle.decode_f32(BASE / \"audits/2026-09-27_pct_precision/ground_precise.f32\")\n    90\tevidence = oracle.decode_f32(BASE / \"audits/2026-09-27_dense_static_sampling/raw_ground.f32\")\n    91\tmap_out, map_added, map_rejected, _ = oracle.fill(nav, evidence)\n    92\tresults[\"oracle\"] = {\"cases_designed\": {n: c[\"designed\"] for n, c in oracle_cases.items()},\n    93\t                     \"map_added\": len(map_added), \"map_rejected\": map_rejected,\n    94\t                     \"map_added_by_level_m\": {}}\n    95\tfor _, z in map_added:\n    96\t    key = f\"{round(z, 1):.1f}\"\n    97\t    results[\"oracle\"][\"map_added_by_level_m\"][key] = results[\"oracle\"][\"map_added_by_level_m\"].get(key, 0) + 1\n    98\t\n    99\tfor label, green in LABELS.items():\n   100\t    out_dir = HERE / label\n   101\t    exit_codes = {p.name: p.read_text().strip() for p in out_dir.glob(\"*_exit_code.txt\")}\n   102\t    native = read_case_layers(out_dir / \"cases_layers.csv\")\n   103\t    summaries = {r[\"case\"]: r for r in csv.DictReader((out_dir / \"cases_summary.csv\").open())}\n   104\t    case_results = {}\n   105\t    for name, o in oracle_cases.items():\n   106\t        expected = o[\"out\"] if green else o[\"navigation\"].cells\n   107\t        got = native.get(name, {})\n   108\t        equal = got.keys() == expected.keys() and all(got[c] == expected[c] for c in expected)\n   109\t        added = [(c, z) for c in got for z in got[c][len(o[\"navigation\"].cells.get(c, [])):]]\n   110\t        entry = {\"equals_expected\": equal, \"native_added\": int(summaries[name][\"added\"]),\n   111\t                 \"native_evidence_used\": summaries[name][\"evidence_used\"] == \"1\"}\n   112\t        if green:\n   113\t            entry[\"designed\"] = designed(name, o[\"navigation\"], got, added)\n   114\t            entry[\"passed\"] = equal and entry[\"designed\"] and o[\"designed\"] and entry[\"native_added\"] == len(o[\"added\"])\n   115\t        else:\n   116\t            entry[\"passed\"] = equal and entry[\"native_added\"] == 0 and not entry[\"native_evidence_used\"]\n   117\t        case_results[name] = entry\n   118\t    fill = json.loads((out_dir / \"fill.json\").read_text())\n   119\t    added_rows = [((int(r[\"ix\"]), int(r[\"iy\"])), float(r[\"elevation\"])) for r in csv.DictReader((out_dir / \"map_added.csv\").open())]\n   120\t    if green:\n   121\t        map_passed = (fill[\"fill_available\"] and fill[\"navigation_layers_changed\"] == 0 and\n   122\t                      sorted(added_rows) == sorted(map_added) and fill[\"map_added\"] == len(map_added) and\n   123\t                      fill[\"map_rejected\"] == map_rejected)\n   124\t    else:\n   125\t        map_passed = not fill[\"fill_available\"] and not added_rows and fill[\"map_added\"] == 0\n   126\t    node = {}\n   127\t    for order in (\"nav_first\", \"evidence_first\"):\n   128\t        record = json.loads((out_dir / f\"order_{order}.json\").read_text())\n   129\t        checks = []\n   130\t        for name, cp in record[\"checkpoints\"].items():\n   131\t            if \"raw_differs\" not in cp:\n   132\t                checks.append(cp[\"node_raw_layers\"] == 0)\n   133\t                continue\n   134\t            ok = cp[\"raw_differs\"] == 0 and cp[\"terrain_differs\"] == 0 and cp[\"decision_differs_from_node\"] == 0\n   135\t            if green:\n   136\t                ok = ok and cp.get(\"kept_navigation_differs\") == 0\n   137\t            checks.append(ok)\n   138\t        expected_added = record[\"expected_added\"]\n   139\t        if green:\n   140\t            adds = (expected_added[\"none\"] == 0 and expected_added[\"surface\"] == len(map_added) and\n   141\t                    0 < expected_added[\"holed\"] < expected_added[\"surface\"])\n   142\t        else:\n   143\t            adds = expected_added == {\"none\": 0, \"surface\": 0, \"holed\": 0}\n   144\t        node[order] = {\"checkpoints\": len(checks), \"all_equal\": all(checks), \"added_as_expected\": adds,\n   145\t                       \"expected_added\": expected_added, \"removed_evidence_points\": record[\"removed_evidence_points\"]}\n   146\t    results[\"cases\"][label] = case_results\n   147\t    results[\"map\"][label] = {\"passed\": map_passed, \"native\": {k: fill[k] for k in (\n   148\t        \"fill_available\", \"map_added\", \"map_rejected\", \"navigation_layers_changed\", \"fill_ms_best_of_3\", \"added_step_labels\")}}\n   149\t    results[\"node\"][label] = node\n   150\t    results[label + \"_exit_codes\"] = exit_codes\n   151\t\n   152\tresults[\"passed\"] = (all(c[\"passed\"] for label in LABELS for c in results[\"cases\"][label].values()) and\n   153\t                     all(results[\"map\"][label][\"passed\"] for label in LABELS) and\n   154\t                     all(n[\"all_equal\"] and n[\"added_as_expected\"] for label in LABELS for n in results[\"node\"][label].values()) and\n   155\t                     all(v == \"0\" for label in LABELS for v in results[label + \"_exit_codes\"].values()) and\n   156\t                     all(results[\"oracle\"][\"cases_designed\"].values()))\n   157\t(HERE / \"contract_results.json\").write_text(json.dumps(results, indent=2) + \"\\n\")\n   158\tprint(json.dumps({\"passed\": results[\"passed\"],\n   159\t                  \"cases_failed\": {l: [n for n, c in results[\"cases\"][l].items() if not c[\"passed\"]] for l in LABELS},\n   160\t                  \"map\": {l: results[\"map\"][l][\"passed\"] for l in LABELS},\n   161\t                  \"node\": {l: {o: (n[\"all_equal\"], n[\"added_as_expected\"]) for o, n in results[\"node\"][l].items()} for l in LABELS},\n   162\t                  \"oracle_map_added\": len(map_added), \"oracle_map_rejected\": map_rejected}, indent=1))\n","exit_code":0,"status":"completed"}}
