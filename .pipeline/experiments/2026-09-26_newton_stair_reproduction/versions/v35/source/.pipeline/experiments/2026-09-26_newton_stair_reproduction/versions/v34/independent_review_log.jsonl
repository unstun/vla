{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc 'nl -ba .pipeline/experiments/2026-09-26_newton_stair_reproduction/versions/v34/freeze.py\ncat .pipeline/experiments/2026-09-26_newton_stair_reproduction/hosts/2026-09-29_gpu5070ti/make_v34_files.json\nnl -ba .pipeline/experiments/2026-09-26_newton_stair_reproduction/hosts/2026-09-29_gpu5070ti/checks/p1_gates_v34.py'","aggregated_output":"     1\t\"\"\"Freeze v34 after K1-K5 (PLAN.md), before any v34 physics. Adapted from versions/v31/freeze.py and v33/freeze.py.\"\"\"\n     2\tfrom pathlib import Path\n     3\tfrom datetime import datetime, timezone\n     4\timport hashlib, json, shutil\n     5\t\n     6\tH = Path(__file__).resolve().parent\n     7\tB = H.parents[1]\n     8\tR = B.parents[2]\n     9\tsha = lambda p: hashlib.sha256(p.read_bytes()).hexdigest()\n    10\tload = lambda p: json.loads(p.read_text())\n    11\tparent = load(H.parent / 'v33/manifest.json')\n    12\tprepared = load(H / 'prepared.json')\n    13\tN = R / prepared['native_build']\n    14\tA = B / 'audits/2026-09-29_corridor_entry'\n    15\tassert not (H / 'manifest.json').exists()\n    16\tassert load(H / 'check_build.json')['passed']                                                        # K1\n    17\tassert load(H / 'fill_contract/contract_results.json')['passed']                                     # K2\n    18\tfor state in ('v33_stand', 'v32_stand'):                                                             # K3\n    19\t    result = load(H / 'stand_replay' / state / 'result_green.json')\n    20\t    assert (H / 'stand_replay' / state / 'probe_green_exit_code.txt').read_text().strip() == '0'\n    21\t    assert result['live']['ok'] and result['live']['committed']['check']['status'] == 0, state\n    22\t    assert result['circle_mismatches'] == result['support_mismatches'] == result['query_mismatches'] == 0, state\n    23\tfor run in ('v34_saved_states01', 'v34_native_regression01'):                                        # K4\n    24\t    assert load(B / 'runs' / run / 'review.json')['component_scope_passed'], run\n    25\t    alone = load(B / 'runs' / run / 'alone_check.json')\n    26\t    assert alone['samples_with_other_containers'] == 0 and alone['execute_exit_code'] == 0, run\n    27\tassert load(H / 'independent_review.json')['passed']                                                 # K5\n    28\tchanged = set(prepared['changed_files'])\n    29\tfor name, digest in parent['source_files'].items():\n    30\t    if name not in changed:\n    31\t        assert sha(R / name) == digest, name\n    32\tfor name, digest in load(N / 'source_sha256.json').items():\n    33\t    assert sha(N / name) == digest, name\n    34\tnative_parent = load(R / prepared['native_parent'] / 'source_sha256.json')\n    35\tpreimages = [p for p in (H / 'parent_source').rglob('*') if p.is_file()]\n    36\tassert len(preimages) == 2\n    37\tfor p in preimages:\n    38\t    assert sha(p) == native_parent[str(p.relative_to(H / 'parent_source'))], p\n    39\tassert load(N / 'build_result.json')['passed']\n    40\tshutil.copyfile(N / 'build_result.json', H / 'build_result.json')\n    41\tshutil.copyfile(N / 'install_sha256.json', H / 'install_sha256.json')\n    42\tBUILD_TREES = {'build', 'probe_build', 'breakdown_build', '__pycache__'}\n    43\tselected = {R / name for name in parent['source_files']} | {R / name for name in changed}\n    44\tselected.update(p for p in (N / 'src').rglob('*') if p.is_file())\n    45\tselected.add(N / 'source_sha256.json')\n    46\t# Version files, without the snapshot itself and the CMake build trees of the contract and the stand replay.\n    47\tfor p in H.rglob('*'):\n    48\t    parts = p.relative_to(H).parts\n    49\t    if p.is_file() and parts[0] != 'source' and not BUILD_TREES & set(parts):\n    50\t        selected.add(p)\n    51\t# The diagnosis the version rests on: its tracked files (not its local-only frozen inputs, grounds or probe build).\n    52\tlocal_only = {f['path'] for group in ('raw_artifacts', 'regenerable_caches') for entry in load(A / 'LOCAL_ONLY_BYTES.json')[group]\n    53\t              for f in entry['files']}\n    54\tfor p in A.rglob('*'):\n    55\t    if p.is_file() and str(p.relative_to(R)) not in local_only and not BUILD_TREES & set(p.relative_to(A).parts):\n    56\t        selected.add(p)\n    57\t# K4: every file of the two runs except their CMake build trees.\n    58\tfor run in ('v34_saved_states01', 'v34_native_regression01'):\n    59\t    selected.update(p for p in (B / 'runs' / run).rglob('*') if p.is_file() and not BUILD_TREES & set(p.relative_to(B / 'runs' / run).parts))\n    60\t# The trial's host files: the derived runner and gate check, and their derivation record.\n    61\tG = B / 'hosts/2026-09-29_gpu5070ti'\n    62\tselected.update({G / 'v34_trial_run.sh', G / 'make_v34_files.py', G / 'make_v34_files.json', G / 'checks/p1_gates_v34.py'})\n    63\trecords = {}\n    64\tfor p in sorted(selected):\n    65\t    name = str(p.relative_to(R))\n    66\t    records[name] = sha(p)\n    67\t    dest = H / 'source' / name\n    68\t    dest.parent.mkdir(parents=True, exist_ok=True)\n    69\t    shutil.copyfile(p, dest)\n    70\t(H / 'manifest.json').write_text(json.dumps({\n    71\t    'version': 'v34', 'parent': 'v33', 'status': 'frozen_unvalidated', 'frozen_utc': datetime.now(timezone.utc).isoformat(),\n    72\t    'change': 'When SCAN accepts its ground inputs, its copy of PCT\\'s navigation ground gains each surface-evidence layer '\n    73\t              'that the navigation cell containing the evidence cell\\'s centre lacks within 0.12 m (body_height_tolerance), '\n    74\t              'unless an evidence cell within 0.35 m (double_cylinder_radius, square to square) of the candidate has no '\n    75\t              'surface within 0.26 m (the step capability) of the layer and either no surface at all or one more than '\n    76\t              '0.26 m below it (a drop). New evidence re-augments the navigation ground as decoded. On the pinned grounds '\n    77\t              'it adds 17,214 layers and rejects 22,785 beside drops. The step score, support query, decision, thresholds, '\n    78\t              'occupancy and planner are unchanged. Native tree runtime/scan65_evidence_floor_v34 (three files: '\n    79\t              'evidence_floor_fill.h new, grid_map.h, scan_reactive_grid_methods.inc).',\n    80\t    'decisions': 'Dr Sun, 2026-09-29, after the corridor-entry diagnosis (audits/2026-09-29_corridor_entry): \"Floor fallback '\n    81\t                 'in SCAN\" (over correcting the pinned map, or the wrong-height cells only), and the single trial on '\n    82\t                 'gpu5070ti as for v33. The drop guard is the author\\'s stricter refinement, disclosed in PLAN.md.',\n    83\t    'source_files': records, 'changed_files': sorted(changed), 'native_build': prepared['native_build'],\n    84\t    'source_snapshot_prefix': 'source/', 'acceptance_plan': 'PLAN.md',\n    85\t    'freeze_boundary': 'After K1 byte-exact materialization and build, K2 the red/green fill contract (cases, real map, node '\n    86\t                       'orders), K3 the two frozen corridor-entry stands, K4 the saved-state and native-regression suites '\n    87\t                       'with every difference explained, and K5 independent review (independent_review.json); before any '\n    88\t                       'v34 physics (one trial, v34_historical_full01, on gpu5070ti).'},\n    89\t    indent=2) + '\\n')\n    90\tprint(json.dumps({'version': 'v34', 'source_files': len(records)}))\n{\n  \"runner\": {\n    \"source\": \"v33_trial_run.sh\",\n    \"source_sha256\": \"2649f0e8afbd67b07ce464a4bdc6abfe348cdb53fb5a91b840b539f6214e91cb\",\n    \"target\": \"v34_trial_run.sh\",\n    \"target_sha256\": \"1ecb76aef9aa7aa1e7fc80171137451acdfb49c7ddd31af5ea548e19390e2c81\",\n    \"lines\": 205,\n    \"changed_lines\": [\n      2,\n      7,\n      8,\n      9,\n      17,\n      18,\n      32,\n      35,\n      37,\n      38,\n      40,\n      41,\n      197,\n      199,\n      200\n    ]\n  },\n  \"gates\": {\n    \"source\": \"p1_gates.py\",\n    \"source_sha256\": \"c7d536aa39770468062f5b0d6041c2128a82a65ae4e0c8c4a89a6ce44212ec14\",\n    \"target\": \"checks/p1_gates_v34.py\",\n    \"target_sha256\": \"4b24dcf25bc53cba14200c0b71a2d071c1ae5c966097617bfcc432a8c9ed21c8\",\n    \"lines\": 48,\n    \"changed_lines\": [\n      16,\n      19,\n      31\n    ],\n    \"added\": \"reviewed_candidate gate (launcher lines 158-162)\"\n  }\n}\n     1\t\"\"\"P1 on gpu5070ti: the pre-physics gates of scripts/run_local_episode.py, executed on the execution copy.\n     2\tThe version gate (verify_integration_version, lines 62-77) and the record gate (lines 163-165) are executed from their\n     3\town source text; the native-build identity is checked as freeze.py and the launcher do (source_sha256.json).\"\"\"\n     4\timport ast, hashlib, json, sys\n     5\tfrom pathlib import Path\n     6\tR = Path.home() / \"vla_exec/vla\"\n     7\tBASE = R / \".pipeline/experiments/2026-09-26_newton_stair_reproduction\"\n     8\tsrc = (BASE / \"scripts/run_local_episode.py\").read_text()\n     9\tlines = src.splitlines()\n    10\tout = {}\n    11\t# version gate: run the function's own text against a scratch output directory\n    12\ttree = ast.parse(src)\n    13\tfn = next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == \"verify_integration_version\")\n    14\tns = {\"BASE\": BASE, \"PROJECT\": R, \"json\": json, \"hashlib\": hashlib, \"shutil\": __import__(\"shutil\")}\n    15\texec(compile(ast.Module(body=[fn], type_ignores=[]), \"verify_integration_version\", \"exec\"), ns)\n    16\tscratch = Path.home() / \"vla_exec/port/p1_scratch_v34\"\n    17\tscratch.mkdir(parents=True, exist_ok=True)\n    18\ttry:\n    19\t    out[\"version_gate\"] = {\"passed\": ns[\"verify_integration_version\"](scratch, \"v34\") == \"v34\"}\n    20\texcept Exception as exc:\n    21\t    out[\"version_gate\"] = {\"passed\": False, \"error\": str(exc)}\n    22\t# record gate: lines 163-165 verbatim\n    23\tblock = \"\\n\".join(l[4:] for l in lines[162:165])\n    24\tassert block.startswith('for record in json.loads((BASE / \"setup/runtime_sources.json\")'), block\n    25\ttry:\n    26\t    exec(block, {\"BASE\": BASE, \"json\": json, \"hashlib\": hashlib})\n    27\t    out[\"record_gate\"] = {\"passed\": True, \"records\": len(json.loads((BASE / \"setup/runtime_sources.json\").read_text())[\"records\"])}\n    28\texcept Exception as exc:\n    29\t    out[\"record_gate\"] = {\"passed\": False, \"error\": str(exc)}\n    30\t# native build identity\n    31\tN = BASE / \"runtime/scan65_evidence_floor_v34\"\n    32\t# both manifests the launcher checks (lines 152-155); install_sha256.json was added after P6's first attempt found\n    33\t# the build's __pycache__ files missing from the copy\n    34\tbad, counts = [], {}\n    35\tfor name in (\"source_sha256.json\", \"install_sha256.json\"):\n    36\t    manifest = json.loads((N / name).read_text())\n    37\t    counts[name] = len(manifest)\n    38\t    bad += [n for n, d in manifest.items() if not (N / n).is_file() or hashlib.sha256((N / n).read_bytes()).hexdigest() != d]\n    39\tout[\"native_identity\"] = {\"passed\": not bad and json.loads((N / \"build_result.json\").read_text())[\"passed\"],\n    40\t                          \"files\": counts, \"mismatches\": bad}\n    41\t# reviewed candidate (run_local_episode.py lines 158-162, applied to geometry-only episodes such as the trial)\n    42\tidentities = [json.loads(p.read_text()) for p in (BASE / \"repairs/2026-09-26_generic_occupancy\").glob(\"candidate*identity*.json\")]\n    43\tout[\"reviewed_candidate\"] = {\"passed\": any(json.loads((N / \"source_sha256.json\").read_text()) == i[\"source_sha256\"] for i in identities),\n    44\t                             \"identities_checked\": len(identities)}\n    45\timport shutil\n    46\tout[\"free_disk\"] = {\"passed\": shutil.disk_usage(BASE).free >= 10 * 1024**3, \"free_gib\": round(shutil.disk_usage(BASE).free / 1024**3, 1)}\n    47\t# scene inputs as scene_assets.verify_inputs checks them\n    48\tident = json.loads((BASE / \"setup/source_identity.json\").read_text())\n    49\tbad = [i[\"path\"] for i in ident[\"inputs\"] if hashlib.sha256((BASE / i[\"path\"]).read_bytes()).hexdigest() != i[\"sha256\"]]\n    50\tout[\"scene_inputs\"] = {\"passed\": not bad, \"inputs\": len(ident[\"inputs\"]), \"mismatches\": bad}\n    51\tout[\"passed\"] = all(v[\"passed\"] for v in out.values())\n    52\tprint(json.dumps(out, indent=2))\n","exit_code":0,"status":"completed"}}
