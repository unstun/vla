+void ControllerServer::checkProgress(geometry_msgs::msg::PoseStamped &pose)
+{
+  // Compute first so the first terminal tick cannot fail on an old movement
+  // deadline. Nothing is published until this check succeeds.
+  auto *execution = dynamic_cast<scan_nav2_controller::ExecutionControl *>(
+    controllers_[current_controller_].get());
+  if (execution && execution->terminalPhase()) {
+    progress_checker_->reset();
+  } else if (!progress_checker_->check(pose)) {
+    throw nav2_core::PlannerException("Failed to make progress");
+  }
+
 }
 
