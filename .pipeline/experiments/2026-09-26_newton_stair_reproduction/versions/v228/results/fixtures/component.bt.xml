<root main_tree_to_execute="MainTree">
 <BehaviorTree ID="MainTree">
  <RecoveryNode number_of_retries="6" name="NavigateRecovery">
   <PipelineSequence name="NavigateWithReplanning">
    <RateController hz="1.0">
     <ComputePathToPose goal="{goal}" path="{path}" planner_id="PCT" server_name="/compute_path_to_pose" server_timeout="1000"/>
    </RateController>
    <FollowPathWithFailure path="{path}" controller_id="SCAN" server_name="/follow_path" server_timeout="1000"/>
   </PipelineSequence>
   <Sequence>
    <RetryAllowed/>
    <Wait wait_duration="1" server_name="/wait" server_timeout="1000"/>
   </Sequence>
  </RecoveryNode>
 </BehaviorTree>
</root>
