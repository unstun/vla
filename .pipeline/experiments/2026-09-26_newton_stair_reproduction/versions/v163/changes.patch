+#include <cmath>
 
 namespace lite3_nav2 {
+struct GlobalReference {
+  geometry_msgs::msg::PoseStamped goal;
+  nav_msgs::msg::Path path;
+};
+class RememberGlobalPath : public BT::SyncActionNode {
+public:
+  RememberGlobalPath(const std::string &name,const BT::NodeConfiguration &config)
+    : BT::SyncActionNode(name,config) {}
+  static BT::PortsList providedPorts() {
+    return {BT::InputPort<geometry_msgs::msg::PoseStamped>("goal"),BT::InputPort<nav_msgs::msg::Path>("path")};
+  }
+  BT::NodeStatus tick() override {
+    GlobalReference saved;
+    if(!getInput("goal",saved.goal)||!getInput("path",saved.path)||saved.path.poses.size()<2||
+       saved.path.header.frame_id.empty()||saved.path.header.frame_id!=saved.goal.header.frame_id)
+      return BT::NodeStatus::FAILURE;
+    for(const auto &pose:saved.path.poses) {
+      const auto &p=pose.pose.position;
+      if(pose.header.frame_id!=saved.path.header.frame_id||
+         !std::isfinite(p.x)||!std::isfinite(p.y)||!std::isfinite(p.z))return BT::NodeStatus::FAILURE;
+    }
+    config().blackboard->set("lite3_previous_pct_reference",saved);
+    return BT::NodeStatus::SUCCESS;
+  }
+};
+class RestoreGlobalPath : public BT::SyncActionNode {
+public:
+  RestoreGlobalPath(const std::string &name,const BT::NodeConfiguration &config)
+    : BT::SyncActionNode(name,config) {}
+  static BT::PortsList providedPorts() {
+    return {BT::InputPort<geometry_msgs::msg::PoseStamped>("goal"),BT::OutputPort<nav_msgs::msg::Path>("path")};
+  }
+  BT::NodeStatus tick() override {
+    GlobalReference saved;geometry_msgs::msg::PoseStamped goal;
+    if(!getInput("goal",goal)||!config().blackboard->get("lite3_previous_pct_reference",saved)||saved.goal!=goal)
+      return BT::NodeStatus::FAILURE;
+    // Geometry and source timestamp remain exact. The gateway independently
+    // requires the same mission/map and a physically released old owner.
+    setOutput("path",saved.path);
+    return BT::NodeStatus::SUCCESS;
+  }
+};
