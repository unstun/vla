# Reproducible Vendor Skill checkout. The exact source is tracked in
# vendor-skills.lock and restored by sync-skills.sh; do not embed its Git clone.
/.skills-upstream/

# Local runtime and operating-system files.
__pycache__/
*.py[cod]
.DS_Store
.env
.venv/

# Project-owned Skills are real tracked directories under .agents/skills.
# Generated Vendor symlinks in that directory stay ignored.
/.agents/skills/*
!/.agents/skills/*/
!/.agents/skills/*/**

# Claude Code and Cursor platform links are generated by sync-skills.sh.
# Trellis-managed real directories remain tracked; already tracked project
# links remain valid, while new project links can be regenerated from .agents.
/.claude/skills/*
!/.claude/skills/trellis-*/
!/.claude/skills/trellis-*/**

/.cursor/skills/*
!/.cursor/skills/trellis-*/
!/.cursor/skills/trellis-*/**

# Keep generated caches ignored after project-Skill unignore rules.
**/__pycache__/
**/*.pyc

# Scratch directory: working files only, never a deliverable.
/tmp/

# Evidence policy
# ---------------
# Do not add repository-wide extension ignores for papers, images, videos,
# archives, models, meshes, or CAD. A new artifact must remain visible to Git
# until a task decides whether to track it directly, use Git LFS, or keep its
# bytes local. Local-only bytes require a dated path-specific ignore entry plus
# tracked provenance, SHA-256, storage location, and regeneration instructions.
