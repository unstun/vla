# Live clone of https://github.com/mattpocock/skills.git — pull it for updates,
# don't embed it in this repo. The .claude/skills and .agents/skills symlinks
# point into it. See SKILLS.md.
/.skills-upstream/

# Local runtime and operating-system files.
__pycache__/
*.py[cod]
.DS_Store
.env
.venv/

# Regenerated vendor symlinks remain ignored. Trellis-managed and project-owned
# skills are tracked explicitly so a fresh clone has the same research harness.
/.claude/skills/*
/.agents/skills/*

!/.claude/skills/trellis-*
!/.agents/skills/trellis-*/
!/.agents/skills/trellis-*/**

