            "        params={",
            "            \"command_name\": \"base_velocity\",",
            "            \"asset_cfg\": SceneEntityCfg(\"robot\", joint_names=\".*_(HipY|Knee)_joint\"),",
            "            \"stand_still_scale\": 1.0,",
            "            \"velocity_threshold\": 0.1,",
            "            \"command_threshold\": 0.1,",
            "        },",
            "    )",
